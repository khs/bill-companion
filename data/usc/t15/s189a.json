{"title":"15","section":"189a","heading":"Repealed. Pub. L. 91–412, § 3(b), (c), Sept. 25, 1970, 84 Stat. 864","lead":"","tree":[],"notes":[{"topic":"removalDescription","heading":"","text":"Section 189, act May 15, 1936, ch. 405, § 1, 49 Stat. 1335, which authorized Secretary of Commerce to charge for lists of foreign buyers, special statistical services, special commodity news bulletins, and World Trade Directory reports and to deposit collections therefore in the Treasury as miscellaneous receipts, is now covered by sections 1525 and 1526 of this title. Similar provisions were contained in the following acts:"},{"topic":"removalDescription","heading":"","text":"Mar. 22, 1935, ch. 39, 49 Stat. 89."},{"topic":"removalDescription","heading":"","text":"Apr. 7, 1934, ch. 104, 48 Stat. 550."},{"topic":"removalDescription","heading":"","text":"Mar. 1, 1933, ch. 144, 47 Stat. 1392."},{"topic":"removalDescription","heading":"","text":"July 1, 1932, ch. 361, 47 Stat. 501."},{"topic":"removalDescription","heading":"","text":"June 30, 1932, ch. 314, pt. II, title III, § 310, 47 Stat. 410."},{"topic":"removalDescription","heading":"","text":"Feb. 23, 1931, ch. 280, 46 Stat. 1333."},{"topic":"removalDescription","heading":"","text":"Apr. 18, 1930, ch. 184, 46 Stat. 197."},{"topic":"removalDescription","heading":"","text":"Jan. 25, 1929, ch. 102, 45 Stat. 1118."},{"topic":"removalDescription","heading":"","text":"Feb. 15, 1928, ch. 57, 45 Stat. 87."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 15—","heading":"COMMERCE AND TRADE","identifier":"/us/usc/t15"},{"type":"chapter","num":"CHAPTER 5—","heading":"STATISTICAL AND COMMERCIAL INFORMATION","identifier":"/us/usc/t15/ch5"}]}