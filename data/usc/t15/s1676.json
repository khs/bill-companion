{"title":"15","section":"1676","heading":"Enforcement by Secretary of Labor","lead":"The Secretary of Labor, acting through the Wage and Hour Division of the Department of Labor, shall enforce the provisions of this subchapter.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 90–321, title III, § 306, May 29, 1968, 82 Stat. 164.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 15—","heading":"COMMERCE AND TRADE","identifier":"/us/usc/t15"},{"type":"chapter","num":"CHAPTER 41—","heading":"CONSUMER CREDIT PROTECTION","identifier":"/us/usc/t15/ch41"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"RESTRICTIONS ON GARNISHMENT","identifier":"/us/usc/t15/ch41/schII"}]}