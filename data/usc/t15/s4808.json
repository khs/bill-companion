{"title":"15","section":"4808","heading":"Authorization of appropriations","lead":"There are authorized to be appropriated for each of the fiscal years 1991 and 1992 such sums as may be necessary not to exceed $5,000,000 to carry out the provisions of this chapter.","tree":[],"notes":[{"topic":"amendments","heading":"Amendments","text":"1990—Pub. L. 101–382 substituted “1991 and 1992” for “1989 and 1990”."}],"sourceCredit":"(Pub. L. 100–418, title V, § 5209, Aug. 23, 1988, 102 Stat. 1461; Pub. L. 101–382, title I, § 133(e), Aug. 20, 1990, 104 Stat. 649.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 15—","heading":"COMMERCE AND TRADE","identifier":"/us/usc/t15"},{"type":"chapter","num":"CHAPTER 74—","heading":"COMPETITIVENESS POLICY COUNCIL","identifier":"/us/usc/t15/ch74"}]}