{"title":"15","section":"689f","heading":"Fees","lead":"Except as provided in section 689e(d) of this title, the Administrator may charge such fees as it deems appropriate with respect to any guarantee or grant issued under this part.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 85–699, title III, § 357, as added Pub. L. 106–554, § 1(a)(8) [§ 1(b)(3)], Dec. 21, 2000, 114 Stat. 2763, 2763A–660.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 15—","heading":"COMMERCE AND TRADE","identifier":"/us/usc/t15"},{"type":"chapter","num":"CHAPTER 14B—","heading":"SMALL BUSINESS INVESTMENT PROGRAM","identifier":"/us/usc/t15/ch14B"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"INVESTMENT DIVISION PROGRAMS","identifier":"/us/usc/t15/ch14B/schIII"},{"type":"part","num":"Part B—","heading":"New Markets Venture Capital Program","identifier":"/us/usc/t15/ch14B/schIII/ptB"}]}