{"title":"38","section":"3510","heading":"Eligibility and entitlement generally","lead":"Each eligible person shall, subject to the provisions of this chapter, be entitled to receive educational assistance.","tree":[],"notes":[{"topic":"amendments","heading":"Amendments","text":"1991—Pub. L. 102–83 renumbered section 1710 of this title as this section."}],"sourceCredit":"(Pub. L. 85–857, Sept. 2, 1958, 72 Stat. 1194, § 1710; renumbered § 3510, Pub. L. 102–83, § 5(a), Aug. 6, 1991, 105 Stat. 406.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 38—","heading":"VETERANS’ BENEFITS","identifier":"/us/usc/t38"},{"type":"part","num":"PART III—","heading":"READJUSTMENT AND RELATED BENEFITS","identifier":"/us/usc/t38/ptIII"},{"type":"chapter","num":"CHAPTER 35—","heading":"SURVIVORS’ AND DEPENDENTS’ EDUCATIONAL ASSISTANCE","identifier":"/us/usc/t38/ptIII/ch35"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"ELIGIBILITY AND ENTITLEMENT","identifier":"/us/usc/t38/ptIII/ch35/schII"}]}