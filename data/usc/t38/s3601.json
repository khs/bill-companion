{"title":"38","section":"3601","heading":"Definition of emergency situation","lead":"In this chapter, the term “emergency situation” means a situation that—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"the President declares is an emergency; and","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"the Secretary determines is an emergency for purposes of the laws administered by the Secretary.","children":[]}],"notes":[],"sourceCredit":"(Added Pub. L. 117–333, § 2(a)(2), Jan. 5, 2023, 136 Stat. 6122.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 38—","heading":"VETERANS’ BENEFITS","identifier":"/us/usc/t38"},{"type":"part","num":"PART III—","heading":"READJUSTMENT AND RELATED BENEFITS","identifier":"/us/usc/t38/ptIII"},{"type":"chapter","num":"CHAPTER 36—","heading":"ADMINISTRATION OF EDUCATIONAL BENEFITS","identifier":"/us/usc/t38/ptIII/ch36"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"EMERGENCY SITUATIONS","identifier":"/us/usc/t38/ptIII/ch36/schI"}]}