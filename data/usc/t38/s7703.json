{"title":"38","section":"7703","heading":"Functions of the Administration","lead":"The Veterans Benefits Administration is responsible for the administration of the following programs of the Department:","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"Compensation and pension programs.","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"Vocational rehabilitation and educational assistance programs.","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"Veterans’ housing loan programs.","children":[]},{"marker":"(4)","path":"(4)","heading":"","text":"Veterans’ and servicemembers’ life insurance programs.","children":[]},{"marker":"(5)","path":"(5)","heading":"","text":"Outreach programs and other veterans’ services programs.","children":[]}],"notes":[],"sourceCredit":"(Added Pub. L. 102–83, § 2(b), Aug. 6, 1991, 105 Stat. 399.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 38—","heading":"VETERANS’ BENEFITS","identifier":"/us/usc/t38"},{"type":"part","num":"PART V—","heading":"BOARDS, ADMINISTRATIONS, AND SERVICES","identifier":"/us/usc/t38/ptV"},{"type":"chapter","num":"CHAPTER 77—","heading":"VETERANS BENEFITS ADMINISTRATION","identifier":"/us/usc/t38/ptV/ch77"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"ORGANIZATION; GENERAL","identifier":"/us/usc/t38/ptV/ch77/schI"}]}