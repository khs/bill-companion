{"title":"38","section":"1940","heading":"Definition","lead":"For the purposes of this subchapter, the term “insurance” means United States Government life insurance.","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"amendments","text":"Amendments1991—Pub. L. 102–83 renumbered section 740 of this title as this section."}],"sourceCredit":"(Pub. L. 85–857, Sept. 2, 1958, 72 Stat. 1158, § 740; renumbered § 1940, Pub. L. 102–83, § 5(a), Aug. 6, 1991, 105 Stat. 406.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 38—","heading":"VETERANS’ BENEFITS","identifier":"/us/usc/t38"},{"type":"part","num":"PART II—","heading":"GENERAL BENEFITS","identifier":"/us/usc/t38/ptII"},{"type":"chapter","num":"CHAPTER 19—","heading":"INSURANCE","identifier":"/us/usc/t38/ptII/ch19"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"UNITED STATES GOVERNMENT LIFE INSURANCE","identifier":"/us/usc/t38/ptII/ch19/schII"}]}