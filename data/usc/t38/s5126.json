{"title":"38","section":"5126","heading":"Benefits not to be denied based on lack of mailing address","lead":"Benefits under laws administered by the Secretary may not be denied a claimant on the basis that the claimant does not have a mailing address.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 106–475, § 3(b), Nov. 9, 2000, 114 Stat. 2098.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 38—","heading":"VETERANS’ BENEFITS","identifier":"/us/usc/t38"},{"type":"part","num":"PART IV—","heading":"GENERAL ADMINISTRATIVE PROVISIONS","identifier":"/us/usc/t38/ptIV"},{"type":"chapter","num":"CHAPTER 51—","heading":"CLAIMS, EFFECTIVE DATES, AND PAYMENTS","identifier":"/us/usc/t38/ptIV/ch51"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"PAYMENT OF BENEFITS","identifier":"/us/usc/t38/ptIV/ch51/schIII"}]}