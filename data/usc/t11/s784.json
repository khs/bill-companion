{"title":"11","section":"784","heading":"Right to be heard","lead":"The Board or a Federal reserve bank (in the case of a clearing bank that is a member of that bank) may raise and may appear and be heard on any issue in a case under this subchapter.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 106–554, § 1(a)(5) [title I, § 112(c)(5)(B)], Dec. 21, 2000, 114 Stat. 2763, 2763A–395.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 11—","heading":"BANKRUPTCY","identifier":"/us/usc/t11"},{"type":"chapter","num":"CHAPTER 7—","heading":"LIQUIDATION","identifier":"/us/usc/t11/ch7"},{"type":"subchapter","num":"SUBCHAPTER V—","heading":"CLEARING BANK LIQUIDATION","identifier":"/us/usc/t11/ch7/schV"}]}