{"title":"19","section":"4643","heading":"Enforcement priorities","lead":"The Interagency Labor Committee shall—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"review the list of priority sectors under Annex 31–A of the USMCA and suggest to USTR additional sectors for review by the USMCA countries as appropriate;","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"establish and annually update a list of priority subsectors within such priority sectors to be the focus of the enforcement efforts of the Committee, the first of which shall consist of—","children":[{"marker":"(A)","path":"(2)(A)","heading":"","text":"auto assembly;","children":[]},{"marker":"(B)","path":"(2)(B)","heading":"","text":"auto parts;","children":[]},{"marker":"(C)","path":"(2)(C)","heading":"","text":"aerospace;","children":[]},{"marker":"(D)","path":"(2)(D)","heading":"","text":"industrial bakeries;","children":[]},{"marker":"(E)","path":"(2)(E)","heading":"","text":"electronics;","children":[]},{"marker":"(F)","path":"(2)(F)","heading":"","text":"call centers;","children":[]},{"marker":"(G)","path":"(2)(G)","heading":"","text":"mining; and","children":[]},{"marker":"(H)","path":"(2)(H)","heading":"","text":"steel and aluminum; and","children":[]}]},{"marker":"(3)","path":"(3)","heading":"","text":"review priority facilities within such priority subsectors for monitoring and enforcement.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 116–113, title VII, § 713, Jan. 29, 2020, 134 Stat. 82.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 19—","heading":"CUSTOMS DUTIES","identifier":"/us/usc/t19"},{"type":"chapter","num":"CHAPTER 29—","heading":"UNITED STATES–MEXICO–CANADA AGREEMENT IMPLEMENTATION","identifier":"/us/usc/t19/ch29"},{"type":"subchapter","num":"SUBCHAPTER VI—","heading":"LABOR MONITORING AND ENFORCEMENT","identifier":"/us/usc/t19/ch29/schVI"},{"type":"part","num":"Part A—","heading":"Interagency Labor Committee for Monitoring and Enforcement","identifier":"/us/usc/t19/ch29/schVI/ptA"}]}