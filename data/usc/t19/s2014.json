{"title":"19","section":"2014","heading":"Termination of proclamations","lead":"The President is authorized at any time to terminate, in whole or in part, any proclamation issued pursuant to section 2011 or 2012 of this title.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 89–283, title II, § 204, Oct. 21, 1965, 79 Stat. 1018.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 19—","heading":"CUSTOMS DUTIES","identifier":"/us/usc/t19"},{"type":"chapter","num":"CHAPTER 8—","heading":"AUTOMOTIVE PRODUCTS","identifier":"/us/usc/t19/ch8"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"BASIC AUTHORITIES","identifier":"/us/usc/t19/ch8/schII"}]}