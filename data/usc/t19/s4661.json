{"title":"19","section":"4661","heading":"Establishment","lead":"The Secretary of Labor shall—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"hire and fix the compensation of up to 5 additional full-time officers or employees of the Department of Labor; and","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"detail or assign such officers or employees to the United States Embassy or a United States Consulate in Mexico to carry out the duties described in section 4662 of this title.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 116–113, title VII, § 721, Jan. 29, 2020, 134 Stat. 86.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 19—","heading":"CUSTOMS DUTIES","identifier":"/us/usc/t19"},{"type":"chapter","num":"CHAPTER 29—","heading":"UNITED STATES–MEXICO–CANADA AGREEMENT IMPLEMENTATION","identifier":"/us/usc/t19/ch29"},{"type":"subchapter","num":"SUBCHAPTER VI—","heading":"LABOR MONITORING AND ENFORCEMENT","identifier":"/us/usc/t19/ch29/schVI"},{"type":"part","num":"Part B—","heading":"Mexico Labor Attaches","identifier":"/us/usc/t19/ch29/schVI/ptB"}]}