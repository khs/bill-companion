{"title":"19","section":"1649","heading":"Change in designation of customs attachés","lead":"On and after June 17, 1930, customs attachés shall be known as “Treasury attachés.”","tree":[],"notes":[],"sourceCredit":"(June 17, 1930, ch. 497, title IV, § 649, 46 Stat. 762.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 19—","heading":"CUSTOMS DUTIES","identifier":"/us/usc/t19"},{"type":"chapter","num":"CHAPTER 4—","heading":"TARIFF ACT OF 1930","identifier":"/us/usc/t19/ch4"},{"type":"subtitle","num":"SUBTITLE III—","heading":"ADMINISTRATIVE PROVISIONS","identifier":"/us/usc/t19/ch4/stIII"},{"type":"part","num":"Part VI—","heading":"Miscellaneous Provisions","identifier":"/us/usc/t19/ch4/stIII/ptVI"}]}