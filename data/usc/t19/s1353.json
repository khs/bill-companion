{"title":"19","section":"1353","heading":"Indebtedness of foreign countries, effect on","lead":"Nothing in this part shall be construed to give any authority to cancel or reduce, in any manner, any of the indebtedness of any foreign country to the United States.","tree":[],"notes":[],"sourceCredit":"(June 12, 1934, ch. 474, § 3, 48 Stat. 944.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 19—","heading":"CUSTOMS DUTIES","identifier":"/us/usc/t19"},{"type":"chapter","num":"CHAPTER 4—","heading":"TARIFF ACT OF 1930","identifier":"/us/usc/t19/ch4"},{"type":"subtitle","num":"SUBTITLE II—","heading":"SPECIAL PROVISIONS","identifier":"/us/usc/t19/ch4/stII"},{"type":"part","num":"Part III—","heading":"Promotion of Foreign Trade","identifier":"/us/usc/t19/ch4/stII/ptIII"}]}