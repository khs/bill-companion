{"title":"19","section":"579","heading":"Repealed. Aug. 2, 1956, ch. 887, § 4(a)(32), 70 Stat. 948","lead":"","tree":[],"notes":[{"topic":"removalDescription","text":"Section, R.S. § 960, provided that in a suit on bond for the recovery of duties the court should grant judgment unless defendant made an oath that an error was committed in the liquidation of the duties demanded. See section 1514 of this title."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 19—","heading":"CUSTOMS DUTIES","identifier":"/us/usc/t19"},{"type":"chapter","num":"CHAPTER 3—","heading":"THE TARIFF AND RELATED PROVISIONS","identifier":"/us/usc/t19/ch3"},{"type":"subtitle","num":"SUBTITLE IV—","heading":"CUSTOMS ADMINISTRATION","identifier":"/us/usc/t19/ch3/stIV"},{"type":"part","num":"part 6—","heading":"general provisions","identifier":"/us/usc/t19/ch3/stIV/pt6"}]}