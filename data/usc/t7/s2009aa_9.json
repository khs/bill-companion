{"title":"7","section":"2009aa–9","heading":"Consent of States","lead":"Nothing in this subchapter requires any State to engage in or accept any program under this subchapter without the consent of the State.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 87–128, title III, § 382J, as added Pub. L. 106–554, § 1(a)(4) [div. B, title V, § 503], Dec. 21, 2000, 114 Stat. 2763, 2763A–280.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 7—","heading":"AGRICULTURE","identifier":"/us/usc/t7"},{"type":"chapter","num":"CHAPTER 50—","heading":"AGRICULTURAL CREDIT","identifier":"/us/usc/t7/ch50"},{"type":"subchapter","num":"SUBCHAPTER VI—","heading":"DELTA REGIONAL AUTHORITY","identifier":"/us/usc/t7/ch50/schVI"}]}