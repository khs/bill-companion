{"title":"7","section":"6999","heading":"Judicial review","lead":"A final determination of the Division shall be reviewable and enforceable by any United States district court of competent jurisdiction in accordance with chapter 7 of title 5.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 103–354, title II, § 279, Oct. 13, 1994, 108 Stat. 3233.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 7—","heading":"AGRICULTURE","identifier":"/us/usc/t7"},{"type":"chapter","num":"CHAPTER 98—","heading":"DEPARTMENT OF AGRICULTURE REORGANIZATION","identifier":"/us/usc/t7/ch98"},{"type":"subchapter","num":"SUBCHAPTER VIII—","heading":"NATIONAL APPEALS DIVISION","identifier":"/us/usc/t7/ch98/schVIII"}]}