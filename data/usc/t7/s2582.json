{"title":"7","section":"2582","heading":"Severability","lead":"If this chapter is held unconstitutional as to some provisions or circumstances, it shall remain in force as to the remaining provisions and other circumstances.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 91–577, title III, § 132, Dec. 24, 1970, 84 Stat. 1558.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 7—","heading":"AGRICULTURE","identifier":"/us/usc/t7"},{"type":"chapter","num":"CHAPTER 57—","heading":"PLANT VARIETY PROTECTION","identifier":"/us/usc/t7/ch57"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"PLANT VARIETY PROTECTION AND RIGHTS","identifier":"/us/usc/t7/ch57/schIII"},{"type":"part","num":"Part M—","heading":"Intent and Severability","identifier":"/us/usc/t7/ch57/schIII/ptM"}]}