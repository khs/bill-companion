{"title":"7","section":"2544","heading":"Research exemption","lead":"The use and reproduction of a protected variety for plant breeding or other bona fide research shall not constitute an infringement of the protection provided under this chapter.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 91–577, title III, § 114, Dec. 24, 1970, 84 Stat. 1555.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 7—","heading":"AGRICULTURE","identifier":"/us/usc/t7"},{"type":"chapter","num":"CHAPTER 57—","heading":"PLANT VARIETY PROTECTION","identifier":"/us/usc/t7/ch57"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"PLANT VARIETY PROTECTION AND RIGHTS","identifier":"/us/usc/t7/ch57/schIII"},{"type":"part","num":"Part K—","heading":"Infringement of Plant Variety Protection","identifier":"/us/usc/t7/ch57/schIII/ptK"}]}