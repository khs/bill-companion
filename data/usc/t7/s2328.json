{"title":"7","section":"2328","heading":"Library","lead":"The Secretary shall maintain a library of scientific and other works and periodicals, both foreign and domestic, in the Plant Variety Protection Office to aid the examiners in the discharge of their duties.","tree":[],"notes":[{"topic":"amendments","heading":"Amendments","text":"1980—Pub. L. 96–574 substituted “examiners” for “officers”."}],"sourceCredit":"(Pub. L. 91–577, title I, § 8, Dec. 24, 1970, 84 Stat. 1543; Pub. L. 96–574, § 3, Dec. 22, 1980, 94 Stat. 3350.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 7—","heading":"AGRICULTURE","identifier":"/us/usc/t7"},{"type":"chapter","num":"CHAPTER 57—","heading":"PLANT VARIETY PROTECTION","identifier":"/us/usc/t7/ch57"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"PLANT VARIETY PROTECTION OFFICE","identifier":"/us/usc/t7/ch57/schI"},{"type":"part","num":"Part A—","heading":"Organization and Publications","identifier":"/us/usc/t7/ch57/schI/ptA"}]}