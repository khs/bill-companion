{"title":"7","section":"2331","heading":"Copies for public libraries","lead":"The Secretary may supply printed copies of descriptions, drawings, and photographs of protected plant varieties to public libraries in the United States which shall maintain such copies for the use of the public.","tree":[],"notes":[{"topic":"amendments","heading":"Amendments","text":"1980—Pub. L. 96–574 substituted “descriptions” for “specifications”."}],"sourceCredit":"(Pub. L. 91–577, title I, § 11, Dec. 24, 1970, 84 Stat. 1544; Pub. L. 96–574, § 9, Dec. 22, 1980, 94 Stat. 3350.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 7—","heading":"AGRICULTURE","identifier":"/us/usc/t7"},{"type":"chapter","num":"CHAPTER 57—","heading":"PLANT VARIETY PROTECTION","identifier":"/us/usc/t7/ch57"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"PLANT VARIETY PROTECTION OFFICE","identifier":"/us/usc/t7/ch57/schI"},{"type":"part","num":"Part A—","heading":"Organization and Publications","identifier":"/us/usc/t7/ch57/schI/ptA"}]}