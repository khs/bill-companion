{"title":"7","section":"957","heading":"Definitions","lead":"When used in this chapter—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"The term “person” includes individuals, partnerships, corporations, and associations;","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"The term “Secretary” means the Secretary of Agriculture.","children":[]}],"notes":[],"sourceCredit":"(June 24, 1936, ch. 745, § 7, 49 Stat. 1899.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 7—","heading":"AGRICULTURE","identifier":"/us/usc/t7"},{"type":"chapter","num":"CHAPTER 32—","heading":"PEANUT STATISTICS","identifier":"/us/usc/t7/ch32"}]}