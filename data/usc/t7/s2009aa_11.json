{"title":"7","section":"2009aa–11","heading":"Annual report","lead":"Not later than 180 days after the end of each fiscal year, the Authority shall submit to the President and to Congress a report describing the activities carried out under this subchapter.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 87–128, title III, § 382L, as added Pub. L. 106–554, § 1(a)(4) [div. B, title V, § 503], Dec. 21, 2000, 114 Stat. 2763, 2763A–280.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 7—","heading":"AGRICULTURE","identifier":"/us/usc/t7"},{"type":"chapter","num":"CHAPTER 50—","heading":"AGRICULTURAL CREDIT","identifier":"/us/usc/t7/ch50"},{"type":"subchapter","num":"SUBCHAPTER VI—","heading":"DELTA REGIONAL AUTHORITY","identifier":"/us/usc/t7/ch50/schVI"}]}