{"title":"31","section":"6106","heading":"Authorization of appropriations","lead":"After October 1, 1983, there may be appropriated to the Administrator such sums as may be necessary to carry out the responsibilities of this chapter.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 98–169, § 5, Nov. 29, 1983, 97 Stat. 1115.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 31—","heading":"MONEY AND FINANCE","identifier":"/us/usc/t31"},{"type":"subtitle","num":"SUBTITLE V—","heading":"GENERAL ASSISTANCE ADMINISTRATION","identifier":"/us/usc/t31/stV"},{"type":"chapter","num":"CHAPTER 61—","heading":"PROGRAM INFORMATION","identifier":"/us/usc/t31/stV/ch61"}]}