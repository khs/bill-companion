{"title":"10","section":"2514","heading":"Renumbered § 4832]","lead":"","tree":[],"notes":[{"topic":"priorProvisions","heading":"Prior Provisions","text":"A prior section 2514, added Pub. L. 101–510, div. A, title VIII, § 823(a)(3), Nov. 5, 1990, 104 Stat. 1601, directed Secretary of Defense to enhance research relating to manufacturing technology, prior to repeal by Pub. L. 102–484, § 4202(a)."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 10—","heading":"ARMED FORCES","identifier":"/us/usc/t10"},{"type":"subtitle","num":"Subtitle A—","heading":"General Military Law","identifier":"/us/usc/t10/stA"},{"type":"part","num":"PART IV—","heading":"SERVICE, SUPPLY, AND PROPERTY","identifier":"/us/usc/t10/stA/ptIV"},{"type":"chapter","num":"[CHAPTER 148—","heading":"REPEALED]","identifier":"/us/usc/t10/stA/ptIV/ch148"},{"type":"subchapter","num":"[SUBCHAPTER III—","heading":"REPEALED]","identifier":"/us/usc/t10/stA/ptIV/ch148/schIII"}]}