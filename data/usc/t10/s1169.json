{"title":"10","section":"1169","heading":"Regular enlisted members: limitations on discharge","lead":"No regular enlisted member of an armed force may be discharged before his term of service expires, except—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"as prescribed by the Secretary concerned;","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"by sentence of a general or special court martial; or","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"as otherwise provided by law.","children":[]}],"notes":[],"sourceCredit":"(Added Pub. L. 90–235, § 3(a)(1)(A), Jan. 2, 1968, 81 Stat. 757.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 10—","heading":"ARMED FORCES","identifier":"/us/usc/t10"},{"type":"subtitle","num":"Subtitle A—","heading":"General Military Law","identifier":"/us/usc/t10/stA"},{"type":"part","num":"PART II—","heading":"PERSONNEL","identifier":"/us/usc/t10/stA/ptII"},{"type":"chapter","num":"CHAPTER 59—","heading":"SEPARATION","identifier":"/us/usc/t10/stA/ptII/ch59"}]}