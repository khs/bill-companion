{"title":"10","section":"8048","heading":"Medical Officer of the Marine Corps","lead":"","tree":[{"marker":"(a)","path":"(a)","heading":"","text":"There is a Medical Officer of the Marine Corps who shall be appointed from among flag officers of the Navy.","children":[]},{"marker":"(b)","path":"(b)","heading":"","text":"The Medical Officer of the Marine Corps, while so serving, shall hold the grade of rear admiral (lower half).","children":[]}],"notes":[],"sourceCredit":"(Added Pub. L. 118–159, div. A, title V, § 509B(a)(1), Dec. 23, 2024, 138 Stat. 1872.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 10—","heading":"ARMED FORCES","identifier":"/us/usc/t10"},{"type":"subtitle","num":"Subtitle C—","heading":"Navy and Marine Corps","identifier":"/us/usc/t10/stC"},{"type":"part","num":"PART I—","heading":"ORGANIZATION","identifier":"/us/usc/t10/stC/ptI"},{"type":"chapter","num":"CHAPTER 806—","heading":"HEADQUARTERS, MARINE CORPS","identifier":"/us/usc/t10/stC/ptI/ch806"}]}