{"title":"10","section":"2416","heading":"Renumbered § 4957]","lead":"","tree":[],"notes":[{"topic":"priorProvisions","heading":"Prior Provisions","text":"A prior section 2416 was renumbered section 2420 of this title and was subsequently repealed. Prior to repeal, text of section 2420 was transferred to section 4953 of this title."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 10—","heading":"ARMED FORCES","identifier":"/us/usc/t10"},{"type":"subtitle","num":"Subtitle A—","heading":"General Military Law","identifier":"/us/usc/t10/stA"},{"type":"part","num":"PART IV—","heading":"SERVICE, SUPPLY, AND PROPERTY","identifier":"/us/usc/t10/stA/ptIV"},{"type":"chapter","num":"[CHAPTER 142—","heading":"REPEALED]","identifier":"/us/usc/t10/stA/ptIV/ch142"}]}