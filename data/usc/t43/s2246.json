{"title":"43","section":"2246","heading":"Report","lead":"There shall be included as part of the President’s annual budget submittal to the Congress a detailed report on past and proposed expenditures and accomplishments under this chapter.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 102–250, title III, § 306, Mar. 5, 1992, 106 Stat. 59.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 43—","heading":"PUBLIC LANDS","identifier":"/us/usc/t43"},{"type":"chapter","num":"CHAPTER 40—","heading":"RECLAMATION STATES EMERGENCY DROUGHT RELIEF","identifier":"/us/usc/t43/ch40"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"GENERAL AND MISCELLANEOUS PROVISIONS","identifier":"/us/usc/t43/ch40/schIII"}]}