{"title":"43","section":"2430","heading":"Full faith and credit","lead":"The full faith and credit of the United States is pledged to the payment of all guarantees issued under this section with respect to principal and interest.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 109–451, title II, § 211, Dec. 22, 2006, 120 Stat. 3360.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 43—","heading":"PUBLIC LANDS","identifier":"/us/usc/t43"},{"type":"chapter","num":"CHAPTER 42—","heading":"RURAL WATER SUPPLY","identifier":"/us/usc/t43/ch42"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"TWENTY-FIRST CENTURY WATER WORKS","identifier":"/us/usc/t43/ch42/schII"}]}