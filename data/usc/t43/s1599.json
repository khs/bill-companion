{"title":"43","section":"1599","heading":"Definitions","lead":"As used in this subchapter—","tree":[{"marker":"(a)","path":"(a)","heading":"","text":"all terms that are defined in the Colorado River Compact shall have the meanings therein defined;","children":[]},{"marker":"(b)","path":"(b)","heading":"","text":"“Colorado River Basin States” means the States of Arizona, California, Colorado, Nevada, New Mexico, Utah, and Wyoming.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 93–320, title II, § 209, June 24, 1974, 88 Stat. 275.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 43—","heading":"PUBLIC LANDS","identifier":"/us/usc/t43"},{"type":"chapter","num":"CHAPTER 32A—","heading":"COLORADO RIVER BASIN SALINITY CONTROL","identifier":"/us/usc/t43/ch32A"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"MEASURES UPSTREAM FROM IMPERIAL DAM","identifier":"/us/usc/t43/ch32A/schII"}]}