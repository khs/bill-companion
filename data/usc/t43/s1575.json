{"title":"43","section":"1575","heading":"Contract authority","lead":"The Secretary is authorized to enter into contracts that he deems necessary to carry out the provisions of this subchapter in advance of the appropriation of funds therefor.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 93–320, title I, § 105, June 24, 1974, 88 Stat. 270.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 43—","heading":"PUBLIC LANDS","identifier":"/us/usc/t43"},{"type":"chapter","num":"CHAPTER 32A—","heading":"COLORADO RIVER BASIN SALINITY CONTROL","identifier":"/us/usc/t43/ch32A"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"PROGRAMS DOWNSTREAM FROM IMPERIAL DAM","identifier":"/us/usc/t43/ch32A/schI"}]}