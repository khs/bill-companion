{"title":"30","section":"1027","heading":"Land subject to prohibition on leasing","lead":"The Secretary shall not issue any lease under this chapter on those lands subject to the prohibition provided under section 226–3 of this title.","tree":[],"notes":[{"topic":"amendments","heading":"Amendments","text":"2005—Pub. L. 109–58 inserted section catchline."}],"sourceCredit":"(Pub. L. 91–581, § 29, as added Pub. L. 100–443, § 5(d), Sept. 22, 1988, 102 Stat. 1769; amended Pub. L. 109–58, title II, § 236(27), Aug. 8, 2005, 119 Stat. 673.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 30—","heading":"MINERAL LANDS AND MINING","identifier":"/us/usc/t30"},{"type":"chapter","num":"CHAPTER 23—","heading":"GEOTHERMAL RESOURCES","identifier":"/us/usc/t30/ch23"}]}