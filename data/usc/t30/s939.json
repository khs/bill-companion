{"title":"30","section":"939","heading":"Authorization of appropriations","lead":"There is authorized to be appropriated to the Secretary of Labor such sums as may be necessary to carry out his responsibilities under this subchapter. Such sums shall remain available until expended.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 91–173, title IV, § 429, as added Pub. L. 92–303, § 5(8), May 19, 1972, 86 Stat. 156.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 30—","heading":"MINERAL LANDS AND MINING","identifier":"/us/usc/t30"},{"type":"chapter","num":"CHAPTER 22—","heading":"MINE SAFETY AND HEALTH","identifier":"/us/usc/t30/ch22"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"BLACK LUNG BENEFITS","identifier":"/us/usc/t30/ch22/schIV"},{"type":"part","num":"Part C—","heading":"Claims for Benefits After December 31, 1973","identifier":"/us/usc/t30/ch22/schIV/ptC"}]}