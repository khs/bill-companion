{"title":"36","section":"145","heading":"Veterans Day","lead":"The President shall issue each year a proclamation calling on the people of the United States to observe two minutes of silence on Veterans Day in honor of the service and sacrifice of veterans throughout the history of the Nation, beginning at—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"3:11 p.m. Atlantic standard time;","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"2:11 p.m. eastern standard time;","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"1:11 p.m. central standard time;","children":[]},{"marker":"(4)","path":"(4)","heading":"","text":"12:11 p.m. mountain standard time;","children":[]},{"marker":"(5)","path":"(5)","heading":"","text":"11:11 a.m. Pacific standard time;","children":[]},{"marker":"(6)","path":"(6)","heading":"","text":"10:11 a.m. Alaska standard time; and","children":[]},{"marker":"(7)","path":"(7)","heading":"","text":"9:11 a.m. Hawaii-Aleutian standard time.","children":[]}],"notes":[],"sourceCredit":"(Added Pub. L. 114–240, § 2(a), Oct. 7, 2016, 130 Stat. 974.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 36—","heading":"PATRIOTIC AND NATIONAL OBSERVANCES, CEREMONIES, AND ORGANIZATIONS","identifier":"/us/usc/t36"},{"type":"subtitle","num":"Subtitle I—","heading":"Patriotic and National Observances and Ceremonies","identifier":"/us/usc/t36/stI"},{"type":"part","num":"Part A—","heading":"Observances and Ceremonies","identifier":"/us/usc/t36/stI/ptA"},{"type":"chapter","num":"CHAPTER 1—","heading":"PATRIOTIC AND NATIONAL OBSERVANCES","identifier":"/us/usc/t36/stI/ptA/ch1"}]}