{"title":"36","section":"140405","heading":"Powers","lead":"The corporation has only those powers provided in its bylaws and articles of incorporation filed in each State in which it is incorporated.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 111–95, § 1(a), Nov. 6, 2009, 123 Stat. 3002.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 36—","heading":"PATRIOTIC AND NATIONAL OBSERVANCES, CEREMONIES, AND ORGANIZATIONS","identifier":"/us/usc/t36"},{"type":"subtitle","num":"Subtitle II—","heading":"Patriotic and National Organizations","identifier":"/us/usc/t36/stII"},{"type":"part","num":"Part B—","heading":"Organizations","identifier":"/us/usc/t36/stII/ptB"},{"type":"chapter","num":"CHAPTER 1404—","heading":"MILITARY OFFICERS ASSOCIATION OF AMERICA","identifier":"/us/usc/t36/stII/ptB/ch1404"}]}