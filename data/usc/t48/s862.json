{"title":"48","section":"862","heading":"Omitted","lead":"","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Section, act Sept. 21, 1922, ch. 365, 42 Stat. 993, conferred on the courts of Puerto Rico jurisdiction of offenses under act Oct. 28, 1919, ch. 85, 41 Stat. 305, the National Prohibition Act."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 48—","heading":"TERRITORIES AND INSULAR POSSESSIONS","identifier":"/us/usc/t48"},{"type":"chapter","num":"CHAPTER 4—","heading":"PUERTO RICO","identifier":"/us/usc/t48/ch4"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"THE JUDICIARY","identifier":"/us/usc/t48/ch4/schIV"}]}