{"title":"6","section":"744","heading":"Establishment of national preparedness system","lead":"","tree":[{"marker":"(a)","path":"(a)","heading":"Establishment","text":"The President, acting through the Administrator, shall develop a national preparedness system to enable the Nation to meet the national preparedness goal.","children":[]},{"marker":"(b)","path":"(b)","heading":"Components","text":"The national preparedness system shall include the following components:","children":[{"marker":"(1)","path":"(b)(1)","heading":"","text":"Target capabilities and preparedness priorities.","children":[]},{"marker":"(2)","path":"(b)(2)","heading":"","text":"Equipment and training standards.","children":[]},{"marker":"(3)","path":"(b)(3)","heading":"","text":"Training and exercises.","children":[]},{"marker":"(4)","path":"(b)(4)","heading":"","text":"Comprehensive assessment system.","children":[]},{"marker":"(5)","path":"(b)(5)","heading":"","text":"Remedial action management program.","children":[]},{"marker":"(6)","path":"(b)(6)","heading":"","text":"Federal response capability inventory.","children":[]},{"marker":"(7)","path":"(b)(7)","heading":"","text":"Reporting requirements.","children":[]},{"marker":"(8)","path":"(b)(8)","heading":"","text":"Federal preparedness.","children":[]}]},{"marker":"(c)","path":"(c)","heading":"National planning scenarios","text":"The national preparedness system may include national planning scenarios.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 109–295, title VI, § 644, Oct. 4, 2006, 120 Stat. 1425.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 6—","heading":"DOMESTIC SECURITY","identifier":"/us/usc/t6"},{"type":"chapter","num":"CHAPTER 2—","heading":"NATIONAL EMERGENCY MANAGEMENT","identifier":"/us/usc/t6/ch2"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"COMPREHENSIVE PREPAREDNESS SYSTEM","identifier":"/us/usc/t6/ch2/schII"},{"type":"part","num":"Part A—","heading":"National Preparedness System","identifier":"/us/usc/t6/ch2/schII/ptA"}]}