{"title":"42","section":"12408","heading":"Authorization of appropriations","lead":"There is hereby authorized to be appropriated to carry out the purposes of this chapter (in addition to any amounts made available for such purposes under other Acts)—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"$3,000,000 for the fiscal year 1992;","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"$7,000,000 for the fiscal year 1993;","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"$10,000,000 for the fiscal year 1994;","children":[]},{"marker":"(4)","path":"(4)","heading":"","text":"$14,500,000 for fiscal year 1996;","children":[]},{"marker":"(5)","path":"(5)","heading":"","text":"$20,000,000 for fiscal year 1997;","children":[]},{"marker":"(6)","path":"(6)","heading":"","text":"$25,000,000 for fiscal year 1998;","children":[]},{"marker":"(7)","path":"(7)","heading":"","text":"$30,000,000 for fiscal year 1999;","children":[]},{"marker":"(8)","path":"(8)","heading":"","text":"$35,000,000 for fiscal year 2000; and","children":[]},{"marker":"(9)","path":"(9)","heading":"","text":"$40,000,000 for fiscal year 2001.","children":[]}],"notes":[{"topic":"amendments","heading":"Amendments","text":"1996—Pub. L. 104–271 substituted “under other Acts” for “to other Acts” in introductory provisions and added pars. (4) to (9)."}],"sourceCredit":"(Pub. L. 101–566, § 109, Nov. 15, 1990, 104 Stat. 2801; Pub. L. 104–271, title I, § 106, Oct. 9, 1996, 110 Stat. 3306.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 128—","heading":"HYDROGEN RESEARCH, DEVELOPMENT, AND DEMONSTRATION PROGRAM","identifier":"/us/usc/t42/ch128"}]}