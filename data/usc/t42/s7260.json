{"title":"42","section":"7260","heading":"Field offices","lead":"The Secretary is authorized to establish, alter, consolidate or discontinue and to maintain such State, regional, district, local or other field offices as he may deem to be necessary to carry out functions vested in him.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 95–91, title VI, § 650, Aug. 4, 1977, 91 Stat. 601.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 84—","heading":"DEPARTMENT OF ENERGY","identifier":"/us/usc/t42/ch84"},{"type":"subchapter","num":"SUBCHAPTER VI—","heading":"ADMINISTRATIVE PROVISIONS","identifier":"/us/usc/t42/ch84/schVI"},{"type":"part","num":"Part C—","heading":"General Administrative Provisions","identifier":"/us/usc/t42/ch84/schVI/ptC"}]}