{"title":"42","section":"16355","heading":"National Laboratory designation","lead":"After August 8, 2005, the Secretary shall not designate a facility that is not listed in section 15801(3) of this title as a National Laboratory.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 109–58, title IX, § 991, Aug. 8, 2005, 119 Stat. 913.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 149—","heading":"NATIONAL ENERGY POLICY AND PROGRAMS","identifier":"/us/usc/t42/ch149"},{"type":"subchapter","num":"SUBCHAPTER IX—","heading":"RESEARCH AND DEVELOPMENT","identifier":"/us/usc/t42/ch149/schIX"},{"type":"part","num":"Part I—","heading":"Research Administration and Operations","identifier":"/us/usc/t42/ch149/schIX/ptI"}]}