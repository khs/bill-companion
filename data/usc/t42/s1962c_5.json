{"title":"42","section":"1962c–5","heading":"“State” defined","lead":"For the purpose of this subchapter the term “State” means a State, the District of Columbia, Puerto Rico, the Virgin Islands or Guam.","tree":[],"notes":[{"topic":"amendments","heading":"Amendments","text":"1976—Pub. L. 94–285 inserted reference to Guam."}],"sourceCredit":"(Pub. L. 89–80, title III, § 306, July 22, 1965, 79 Stat. 253; Pub. L. 94–285, § 2, May 12, 1976, 90 Stat. 516.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 19B—","heading":"WATER RESOURCES PLANNING","identifier":"/us/usc/t42/ch19B"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"FINANCIAL ASSISTANCE TO STATES FOR COMPREHENSIVE PLANNING GRANT AUTHORIZATIONS","identifier":"/us/usc/t42/ch19B/schIII"}]}