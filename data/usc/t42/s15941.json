{"title":"42","section":"15941","heading":"Great Lakes oil and gas drilling ban","lead":"No Federal or State permit or lease shall be issued for new oil and gas slant, directional, or offshore drilling in or under one or more of the Great Lakes.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 109–58, title III, § 386, Aug. 8, 2005, 119 Stat. 744.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 149—","heading":"NATIONAL ENERGY POLICY AND PROGRAMS","identifier":"/us/usc/t42/ch149"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"OIL AND GAS","identifier":"/us/usc/t42/ch149/schIII"},{"type":"part","num":"Part C—","heading":"Miscellaneous","identifier":"/us/usc/t42/ch149/schIII/ptC"}]}