{"title":"42","section":"10263","heading":"Functions","lead":"The Board shall evaluate the technical and scientific validity of activities undertaken by the Secretary after December 22, 1987, including—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"site characterization activities; and","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"activities relating to the packaging or transportation of high-level radioactive waste or spent nuclear fuel.","children":[]}],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Pub. L. 100–202 and Pub. L. 100–203 added identical sections."}],"sourceCredit":"(Pub. L. 97–425, title V, § 503, as added Pub. L. 100–202, § 101(d) [title III], Dec. 22, 1987, 101 Stat. 1329–104, 1329–121; Pub. L. 100–203, title V, § 5051, Dec. 22, 1987, 101 Stat. 1330–249.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 108—","heading":"NUCLEAR WASTE POLICY","identifier":"/us/usc/t42/ch108"},{"type":"subchapter","num":"SUBCHAPTER V—","heading":"NUCLEAR WASTE TECHNICAL REVIEW BOARD","identifier":"/us/usc/t42/ch108/schV"}]}