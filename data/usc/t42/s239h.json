{"title":"42","section":"239h","heading":"Relationship to other laws","lead":"Except as explicitly provided herein, nothing in this part shall be construed to override or limit any rights an individual may have to seek compensation, benefits, or redress under any other provision of Federal or State law.","tree":[],"notes":[],"sourceCredit":"(July 1, 1944, ch. 373, title II, § 269, as added Pub. L. 108–20, § 2, Apr. 30, 2003, 117 Stat. 645.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 6A—","heading":"PUBLIC HEALTH SERVICE","identifier":"/us/usc/t42/ch6A"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"ADMINISTRATION AND MISCELLANEOUS PROVISIONS","identifier":"/us/usc/t42/ch6A/schI"},{"type":"part","num":"Part C—","heading":"Smallpox Emergency Personnel Protection","identifier":"/us/usc/t42/ch6A/schI/ptC"}]}