{"title":"42","section":"290kk–2","heading":"Limitations on use of funds for certain purposes","lead":"No funds provided under a designated program shall be expended for sectarian worship, instruction, or proselytization.","tree":[],"notes":[],"sourceCredit":"(July 1, 1944, ch. 373, title V, § 596B, formerly § 583, as added Pub. L. 106–554, § 1(a)(7) [title I, § 144], Dec. 21, 2000, 114 Stat. 2763, 2763A–622; renumbered § 596B, Pub. L. 119–44, title I, § 107(a)(2), Dec. 1, 2025, 139 Stat. 674.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 6A—","heading":"PUBLIC HEALTH SERVICE","identifier":"/us/usc/t42/ch6A"},{"type":"subchapter","num":"SUBCHAPTER III–A—","heading":"SUBSTANCE ABUSE AND MENTAL HEALTH SERVICES ADMINISTRATION","identifier":"/us/usc/t42/ch6A/schIII–A"},{"type":"part","num":"Part J—","heading":"Services Provided Through Religious Organizations","identifier":"/us/usc/t42/ch6A/schIII–A/ptJ"}]}