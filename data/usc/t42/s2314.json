{"title":"42","section":"2314","heading":"Repealed. Pub. L. 93–608, § 1(22), Jan. 2, 1975, 88 Stat. 1970","lead":"","tree":[],"notes":[{"topic":"removalDescription","heading":"","text":"Section, act Aug. 4, 1955, ch. 543, ch. 10, § 102, 69 Stat. 483, required a triennial report to the Joint Committee on Atomic Energy by the Commission reviewing its activities under this chapter."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 24—","heading":"DISPOSAL OF ATOMIC ENERGY COMMUNITIES","identifier":"/us/usc/t42/ch24"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"GENERAL PROVISIONS","identifier":"/us/usc/t42/ch24/schI"}]}