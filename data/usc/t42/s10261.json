{"title":"42","section":"10261","heading":"Definitions","lead":"As used in this subchapter:","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"The term “Chairman” means the Chairman of the Nuclear Waste Technical Review Board.","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"The term “Board” means the Nuclear Waste Technical Review Board established under section 10262 of this title.","children":[]}],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Pub. L. 100–202 and Pub. L. 100–203 added identical sections."}],"sourceCredit":"(Pub. L. 97–425, title V, § 501, as added Pub. L. 100–202, § 101(d) [title III], Dec. 22, 1987, 101 Stat. 1329–104, 1329–121; Pub. L. 100–203, title V, § 5051, Dec. 22, 1987, 101 Stat. 1330–248.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 108—","heading":"NUCLEAR WASTE POLICY","identifier":"/us/usc/t42/ch108"},{"type":"subchapter","num":"SUBCHAPTER V—","heading":"NUCLEAR WASTE TECHNICAL REVIEW BOARD","identifier":"/us/usc/t42/ch108/schV"}]}