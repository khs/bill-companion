{"title":"42","section":"12835","heading":"Citizen participation","lead":"The Secretary shall ensure that each participating jurisdiction, and each jurisdiction seeking to become a participating jurisdiction, complies with the requirements of section 12707 of this title.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 101–625, title II, § 285, Nov. 28, 1990, 104 Stat. 4126.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 130—","heading":"NATIONAL AFFORDABLE HOUSING","identifier":"/us/usc/t42/ch130"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"INVESTMENT IN AFFORDABLE HOUSING","identifier":"/us/usc/t42/ch130/schII"},{"type":"part","num":"Part F—","heading":"General Provisions","identifier":"/us/usc/t42/ch130/schII/ptF"}]}