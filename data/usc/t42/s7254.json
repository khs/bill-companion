{"title":"42","section":"7254","heading":"Rules and regulations","lead":"The Secretary is authorized to prescribe such procedural and administrative rules and regulations as he may deem necessary or appropriate to administer and manage the functions now or hereafter vested in him.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 95–91, title VI, § 644, Aug. 4, 1977, 91 Stat. 599.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 84—","heading":"DEPARTMENT OF ENERGY","identifier":"/us/usc/t42/ch84"},{"type":"subchapter","num":"SUBCHAPTER VI—","heading":"ADMINISTRATIVE PROVISIONS","identifier":"/us/usc/t42/ch84/schVI"},{"type":"part","num":"Part C—","heading":"General Administrative Provisions","identifier":"/us/usc/t42/ch84/schVI/ptC"}]}