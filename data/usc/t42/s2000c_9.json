{"title":"42","section":"2000c–9","heading":"Classification and assignment","lead":"Nothing in this subchapter shall prohibit classification and assignment for reasons other than race, color, religion, sex or national origin.","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"amendments","text":"Amendments1972—Pub. L. 92–318 inserted “sex” after “religion,”."}],"sourceCredit":"(Pub. L. 88–352, title IV, § 410, July 2, 1964, 78 Stat. 249; Pub. L. 92–318, title IX, § 906(a), June 23, 1972, 86 Stat. 375.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 21—","heading":"CIVIL RIGHTS","identifier":"/us/usc/t42/ch21"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"PUBLIC EDUCATION","identifier":"/us/usc/t42/ch21/schIV"}]}