{"title":"42","section":"286b–1","heading":"Definitions","lead":"As used in this subpart—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"the term “medical library” means a library related to the sciences related to health; and","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"the term “sciences related to health” includes medicine, osteopathy, dentistry, and public health, and fundamental and applied sciences when related thereto.","children":[]}],"notes":[],"sourceCredit":"(July 1, 1944, ch. 373, title IV, § 470, as added Pub. L. 99–158, § 2, Nov. 20, 1985, 99 Stat. 860.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 6A—","heading":"PUBLIC HEALTH SERVICE","identifier":"/us/usc/t42/ch6A"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"NATIONAL RESEARCH INSTITUTES","identifier":"/us/usc/t42/ch6A/schIII"},{"type":"part","num":"Part D—","heading":"National Library of Medicine","identifier":"/us/usc/t42/ch6A/schIII/ptD"},{"type":"subpart","num":"subpart 2—","heading":"financial assistance","identifier":"/us/usc/t42/ch6A/schIII/ptD/spt2"}]}