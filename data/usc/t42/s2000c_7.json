{"title":"42","section":"2000c–7","heading":"Liability of United States for costs","lead":"In any action or proceeding under this subchapter the United States shall be liable for costs the same as a private person.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 88–352, title IV, § 408, July 2, 1964, 78 Stat. 249.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 21—","heading":"CIVIL RIGHTS","identifier":"/us/usc/t42/ch21"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"PUBLIC EDUCATION","identifier":"/us/usc/t42/ch21/schIV"}]}