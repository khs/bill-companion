{"title":"42","section":"7264","heading":"Seal of Department","lead":"The Secretary shall cause a seal of office to be made for the Department of such design as he shall approve and judicial notice shall be taken of such seal.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 95–91, title VI, § 654, Aug. 4, 1977, 91 Stat. 602.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 84—","heading":"DEPARTMENT OF ENERGY","identifier":"/us/usc/t42/ch84"},{"type":"subchapter","num":"SUBCHAPTER VI—","heading":"ADMINISTRATIVE PROVISIONS","identifier":"/us/usc/t42/ch84/schVI"},{"type":"part","num":"Part C—","heading":"General Administrative Provisions","identifier":"/us/usc/t42/ch84/schVI/ptC"}]}