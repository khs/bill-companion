{"title":"42","section":"15923","heading":"Methodology","lead":"The Secretary of the Interior shall use the same assessment methodology across all geological provinces, areas, and regions in preparing and issuing national geological assessments to ensure accurate comparisons of geological resources.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 109–58, title III, § 364(b), Aug. 8, 2005, 119 Stat. 723.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 149—","heading":"NATIONAL ENERGY POLICY AND PROGRAMS","identifier":"/us/usc/t42/ch149"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"OIL AND GAS","identifier":"/us/usc/t42/ch149/schIII"},{"type":"part","num":"Part B—","heading":"Access to Federal Lands","identifier":"/us/usc/t42/ch149/schIII/ptB"}]}