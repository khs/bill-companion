{"title":"42","section":"11924","heading":"Definitions","lead":"For purposes of this subchapter:","tree":[{"marker":"(1)","path":"(1)","heading":"Controlled substance","text":"The term “controlled substance” has the meaning given such term in section 802 of title 21.","children":[]},{"marker":"(2)","path":"(2)","heading":"Secretary","text":"The term “Secretary” means the Secretary of Housing and Urban Development.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 100–690, title V, § 5145, Nov. 18, 1988, 102 Stat. 4304.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 124—","heading":"PUBLIC HOUSING DRUG ELIMINATION","identifier":"/us/usc/t42/ch124"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"DRUG-FREE PUBLIC HOUSING","identifier":"/us/usc/t42/ch124/schII"}]}