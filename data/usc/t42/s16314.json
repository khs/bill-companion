{"title":"42","section":"16314","heading":"Hydrogen","lead":"","tree":[{"marker":"(a)","path":"(a)","heading":"In general","text":"The Secretary shall conduct a program of fundamental research and development in support of programs authorized under subchapter VIII.","children":[]},{"marker":"(b)","path":"(b)","heading":"Methods","text":"The program shall include support for methods of generating hydrogen without the use of natural gas.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 109–58, title IX, § 974, Aug. 8, 2005, 119 Stat. 903.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 42—","heading":"THE PUBLIC HEALTH AND WELFARE","identifier":"/us/usc/t42"},{"type":"chapter","num":"CHAPTER 149—","heading":"NATIONAL ENERGY POLICY AND PROGRAMS","identifier":"/us/usc/t42/ch149"},{"type":"subchapter","num":"SUBCHAPTER IX—","heading":"RESEARCH AND DEVELOPMENT","identifier":"/us/usc/t42/ch149/schIX"},{"type":"part","num":"Part G—","heading":"Science","identifier":"/us/usc/t42/ch149/schIX/ptG"}]}