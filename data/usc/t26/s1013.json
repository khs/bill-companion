{"title":"26","section":"1013","heading":"Basis of property included in inventory","lead":"If the property should have been included in the last inventory, the basis shall be the last inventory value thereof.","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 296.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle A—","heading":"Income Taxes","identifier":"/us/usc/t26/stA"},{"type":"chapter","num":"CHAPTER 1—","heading":"NORMAL TAXES AND SURTAXES","identifier":"/us/usc/t26/stA/ch1"},{"type":"subchapter","num":"Subchapter O—","heading":"Gain or Loss on Disposition of Property","identifier":"/us/usc/t26/stA/ch1/schO"},{"type":"part","num":"PART II—","heading":"BASIS RULES OF GENERAL APPLICATION","identifier":"/us/usc/t26/stA/ch1/schO/ptII"}]}