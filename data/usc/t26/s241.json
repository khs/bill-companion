{"title":"26","section":"241","heading":"Allowance of special deductions","lead":"In addition to the deductions provided in part VI (sec. 161 and following), there shall be allowed as deductions in computing taxable income the items specified in this part.","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 72.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle A—","heading":"Income Taxes","identifier":"/us/usc/t26/stA"},{"type":"chapter","num":"CHAPTER 1—","heading":"NORMAL TAXES AND SURTAXES","identifier":"/us/usc/t26/stA/ch1"},{"type":"subchapter","num":"Subchapter B—","heading":"Computation of Taxable Income","identifier":"/us/usc/t26/stA/ch1/schB"},{"type":"part","num":"PART VIII—","heading":"SPECIAL DEDUCTIONS FOR CORPORATIONS","identifier":"/us/usc/t26/stA/ch1/schB/ptVIII"}]}