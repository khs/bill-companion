{"title":"26","section":"2046","heading":"Disclaimers","lead":"For provisions relating to the effect of a qualified disclaimer for purposes of this chapter, see section 2518.","tree":[],"notes":[{"topic":"statutoryNotes","text":"Statutory Notes and Related Subsidiaries"},{"topic":"effectiveDate","text":"Effective DateSection applicable to transfers creating an interest in person disclaiming made after Dec. 31, 1976, see section 2009(e)(2) of Pub. L. 94–455, set out as a note under section 2518 of this title."}],"sourceCredit":"(Added Pub. L. 94–455, title XX, § 2009(b)(2), Oct. 4, 1976, 90 Stat. 1893, § 2045; renumbered § 2046, Pub. L. 97–34, title IV, § 403(d)(3)(A)(i), Aug. 13, 1981, 95 Stat. 304.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle B—","heading":"Estate and Gift Taxes","identifier":"/us/usc/t26/stB"},{"type":"chapter","num":"CHAPTER 11—","heading":"ESTATE TAX","identifier":"/us/usc/t26/stB/ch11"},{"type":"subchapter","num":"Subchapter A—","heading":"Estates of Citizens or Residents","identifier":"/us/usc/t26/stB/ch11/schA"},{"type":"part","num":"PART III—","heading":"GROSS ESTATE","identifier":"/us/usc/t26/stB/ch11/schA/ptIII"}]}