{"title":"26","section":"7327","heading":"Customs laws applicable","lead":"The provisions of law applicable to the remission or mitigation by the Secretary of forfeitures under the customs laws shall apply to forfeitures incurred or alleged to have been incurred under the internal revenue laws.","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"amendments","text":"Amendments1976—Pub. L. 94–455 struck out “or his delegate” after “Secretary”."}],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 871; Pub. L. 94–455, title XIX, § 1906(b)(13)(A), Oct. 4, 1976, 90 Stat. 1834.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle F—","heading":"Procedure and Administration","identifier":"/us/usc/t26/stF"},{"type":"chapter","num":"CHAPTER 75—","heading":"CRIMES, OTHER OFFENSES, AND FORFEITURES","identifier":"/us/usc/t26/stF/ch75"},{"type":"subchapter","num":"Subchapter C—","heading":"Forfeitures","identifier":"/us/usc/t26/stF/ch75/schC"},{"type":"part","num":"PART II—","heading":"PROVISIONS COMMON TO FORFEITURES","identifier":"/us/usc/t26/stF/ch75/schC/ptII"}]}