{"title":"26","section":"7321","heading":"Authority to seize property subject to forfeiture","lead":"Any property subject to forfeiture to the United States under any provision of this title may be seized by the Secretary.","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"amendments","text":"Amendments1976—Pub. L. 94–455 struck out “or his delegate” after “Secretary”."}],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 869; Pub. L. 94–455, title XIX, § 1906(b)(13)(A), Oct. 4, 1976, 90 Stat. 1834.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle F—","heading":"Procedure and Administration","identifier":"/us/usc/t26/stF"},{"type":"chapter","num":"CHAPTER 75—","heading":"CRIMES, OTHER OFFENSES, AND FORFEITURES","identifier":"/us/usc/t26/stF/ch75"},{"type":"subchapter","num":"Subchapter C—","heading":"Forfeitures","identifier":"/us/usc/t26/stF/ch75/schC"},{"type":"part","num":"PART II—","heading":"PROVISIONS COMMON TO FORFEITURES","identifier":"/us/usc/t26/stF/ch75/schC/ptII"}]}