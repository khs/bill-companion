{"title":"26","section":"7465","heading":"Provisions of special application to transferees","lead":"","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"For rules of burden of proof in transferee proceedings, see section 6902(a).","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"For authority of Tax Court to prescribe rules by which a transferee of property of a taxpayer shall be entitled to examine books, records and other evidence, see section 6902(b).","children":[]}],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 888, § 7463; renumbered § 7464, Pub. L. 91–172, title IX, § 957(a), Dec. 30, 1969, 83 Stat. 733; renumbered § 7465, Pub. L. 96–589, § 6(c)(1), Dec. 24, 1980, 94 Stat. 3407.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle F—","heading":"Procedure and Administration","identifier":"/us/usc/t26/stF"},{"type":"chapter","num":"CHAPTER 76—","heading":"JUDICIAL PROCEEDINGS","identifier":"/us/usc/t26/stF/ch76"},{"type":"subchapter","num":"Subchapter C—","heading":"The Tax Court","identifier":"/us/usc/t26/stF/ch76/schC"},{"type":"part","num":"PART II—","heading":"PROCEDURE","identifier":"/us/usc/t26/stF/ch76/schC/ptII"}]}