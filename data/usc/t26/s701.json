{"title":"26","section":"701","heading":"Partners, not partnership, subject to tax","lead":"A partnership as such shall not be subject to the income tax imposed by this chapter. Persons carrying on business as partners shall be liable for income tax only in their separate or individual capacities.","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 239.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle A—","heading":"Income Taxes","identifier":"/us/usc/t26/stA"},{"type":"chapter","num":"CHAPTER 1—","heading":"NORMAL TAXES AND SURTAXES","identifier":"/us/usc/t26/stA/ch1"},{"type":"subchapter","num":"Subchapter K—","heading":"Partners and Partnerships","identifier":"/us/usc/t26/stA/ch1/schK"},{"type":"part","num":"PART I—","heading":"DETERMINATION OF TAX LIABILITY","identifier":"/us/usc/t26/stA/ch1/schK/ptI"}]}