{"title":"26","section":"261","heading":"General rule for disallowance of deductions","lead":"In computing taxable income no deduction shall in any case be allowed in respect of the items specified in this part.","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 76.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle A—","heading":"Income Taxes","identifier":"/us/usc/t26/stA"},{"type":"chapter","num":"CHAPTER 1—","heading":"NORMAL TAXES AND SURTAXES","identifier":"/us/usc/t26/stA/ch1"},{"type":"subchapter","num":"Subchapter B—","heading":"Computation of Taxable Income","identifier":"/us/usc/t26/stA/ch1/schB"},{"type":"part","num":"PART IX—","heading":"ITEMS NOT DEDUCTIBLE","identifier":"/us/usc/t26/stA/ch1/schB/ptIX"}]}