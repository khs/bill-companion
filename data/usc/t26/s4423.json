{"title":"26","section":"4423","heading":"Inspection of books","lead":"Notwithstanding section 7605(b), the books of account of any person liable for tax under this chapter may be examined and inspected as frequently as may be needful to the enforcement of this chapter.","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 528.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle D—","heading":"Miscellaneous Excise Taxes","identifier":"/us/usc/t26/stD"},{"type":"chapter","num":"CHAPTER 35—","heading":"TAXES ON WAGERING","identifier":"/us/usc/t26/stD/ch35"},{"type":"subchapter","num":"Subchapter C—","heading":"Miscellaneous Provisions","identifier":"/us/usc/t26/stD/ch35/schC"}]}