{"title":"26","section":"6341","heading":"Expense of levy and sale","lead":"The Secretary shall determine the expenses to be allowed in all cases of levy and sale.","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"amendments","text":"Amendments1976—Pub. L. 94–455 struck out “or his delegate” after “Secretary”."}],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 789; Pub. L. 94–455, title XIX, § 1906(b)(13)(A), Oct. 4, 1976, 90 Stat. 1834.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle F—","heading":"Procedure and Administration","identifier":"/us/usc/t26/stF"},{"type":"chapter","num":"CHAPTER 64—","heading":"COLLECTION","identifier":"/us/usc/t26/stF/ch64"},{"type":"subchapter","num":"Subchapter D—","heading":"Seizure of Property for Collection of Taxes","identifier":"/us/usc/t26/stF/ch64/schD"},{"type":"part","num":"PART II—","heading":"LEVY","identifier":"/us/usc/t26/stF/ch64/schD/ptII"}]}