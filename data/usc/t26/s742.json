{"title":"26","section":"742","heading":"Basis of transferee partner’s interest","lead":"The basis of an interest in a partnership acquired other than by contribution shall be determined under part II of subchapter O (sec. 1011 and following).","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 249.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle A—","heading":"Income Taxes","identifier":"/us/usc/t26/stA"},{"type":"chapter","num":"CHAPTER 1—","heading":"NORMAL TAXES AND SURTAXES","identifier":"/us/usc/t26/stA/ch1"},{"type":"subchapter","num":"Subchapter K—","heading":"Partners and Partnerships","identifier":"/us/usc/t26/stA/ch1/schK"},{"type":"part","num":"PART II—","heading":"CONTRIBUTIONS, DISTRIBUTIONS, AND TRANSFERS","identifier":"/us/usc/t26/stA/ch1/schK/ptII"},{"type":"subpart","num":"Subpart C—","heading":"Transfers of Interests in a Partnership","identifier":"/us/usc/t26/stA/ch1/schK/ptII/sptC"}]}