{"title":"26","section":"1399","heading":"No separate taxable entities for partnerships, corporations, etc.","lead":"Except in any case to which section 1398 applies, no separate taxable entity shall result from the commencement of a case under title 11 of the United States Code.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 96–589, § 3(a)(1), Dec. 24, 1980, 94 Stat. 3400.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle A—","heading":"Income Taxes","identifier":"/us/usc/t26/stA"},{"type":"chapter","num":"CHAPTER 1—","heading":"NORMAL TAXES AND SURTAXES","identifier":"/us/usc/t26/stA/ch1"},{"type":"subchapter","num":"Subchapter V—","heading":"Title 11 Cases","identifier":"/us/usc/t26/stA/ch1/schV"}]}