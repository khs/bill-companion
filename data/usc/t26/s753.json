{"title":"26","section":"753","heading":"Partner receiving income in respect of decedent","lead":"The amount includible in the gross income of a successor in interest of a deceased partner under section 736(a) shall be considered income in respect of a decedent under section 691.","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 251.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle A—","heading":"Income Taxes","identifier":"/us/usc/t26/stA"},{"type":"chapter","num":"CHAPTER 1—","heading":"NORMAL TAXES AND SURTAXES","identifier":"/us/usc/t26/stA/ch1"},{"type":"subchapter","num":"Subchapter K—","heading":"Partners and Partnerships","identifier":"/us/usc/t26/stA/ch1/schK"},{"type":"part","num":"PART II—","heading":"CONTRIBUTIONS, DISTRIBUTIONS, AND TRANSFERS","identifier":"/us/usc/t26/stA/ch1/schK/ptII"},{"type":"subpart","num":"Subpart D—","heading":"Provisions Common to Other Subparts","identifier":"/us/usc/t26/stA/ch1/schK/ptII/sptD"}]}