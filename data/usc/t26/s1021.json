{"title":"26","section":"1021","heading":"Sale of annuities","lead":"In case of the sale of an annuity contract, the adjusted basis shall in no case be less than zero.","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 302.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle A—","heading":"Income Taxes","identifier":"/us/usc/t26/stA"},{"type":"chapter","num":"CHAPTER 1—","heading":"NORMAL TAXES AND SURTAXES","identifier":"/us/usc/t26/stA/ch1"},{"type":"subchapter","num":"Subchapter O—","heading":"Gain or Loss on Disposition of Property","identifier":"/us/usc/t26/stA/ch1/schO"},{"type":"part","num":"PART II—","heading":"BASIS RULES OF GENERAL APPLICATION","identifier":"/us/usc/t26/stA/ch1/schO/ptII"}]}