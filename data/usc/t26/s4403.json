{"title":"26","section":"4403","heading":"Record requirements","lead":"Each person liable for tax under this subchapter shall keep a daily record showing the gross amount of all wagers on which he is so liable, in addition to all other records required pursuant to section 6001(a).","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 525.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle D—","heading":"Miscellaneous Excise Taxes","identifier":"/us/usc/t26/stD"},{"type":"chapter","num":"CHAPTER 35—","heading":"TAXES ON WAGERING","identifier":"/us/usc/t26/stD/ch35"},{"type":"subchapter","num":"Subchapter A—","heading":"Tax on Wagers","identifier":"/us/usc/t26/stD/ch35/schA"}]}