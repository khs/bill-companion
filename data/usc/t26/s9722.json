{"title":"26","section":"9722","heading":"Sham transactions","lead":"If a principal purpose of any transaction is to evade or avoid liability under this chapter, this chapter shall be applied (and such liability shall be imposed) without regard to such transaction.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 102–486, title XIX, § 19143(a), Oct. 24, 1992, 106 Stat. 3056.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle J—","heading":"Coal Industry Health Benefits","identifier":"/us/usc/t26/stJ"},{"type":"chapter","num":"CHAPTER 99—","heading":"COAL INDUSTRY HEALTH BENEFITS","identifier":"/us/usc/t26/stJ/ch99"},{"type":"subchapter","num":"Subchapter D—","heading":"Other Provisions","identifier":"/us/usc/t26/stJ/ch99/schD"}]}