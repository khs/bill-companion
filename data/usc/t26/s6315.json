{"title":"26","section":"6315","heading":"Payments of estimated income tax","lead":"Payment of the estimated income tax, or any installment thereof, shall be considered payment on account of the income taxes imposed by subtitle A for the taxable year.","tree":[],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 778.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle F—","heading":"Procedure and Administration","identifier":"/us/usc/t26/stF"},{"type":"chapter","num":"CHAPTER 64—","heading":"COLLECTION","identifier":"/us/usc/t26/stF/ch64"},{"type":"subchapter","num":"Subchapter B—","heading":"Receipt of Payment","identifier":"/us/usc/t26/stF/ch64/schB"}]}