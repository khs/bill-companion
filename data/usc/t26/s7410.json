{"title":"26","section":"7410","heading":"Cross references","lead":"","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"For provisions for collecting taxes in general, see chapter 64.","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"For venue in a civil action for the collection of any tax, see section 1396 of Title 28 of the United States Code.","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"For venue of a proceeding for the recovery of any fine, penalty, or forfeiture, see section 1395 of Title 28 of the United States Code.","children":[]}],"notes":[],"sourceCredit":"(Aug. 16, 1954, ch. 736, 68A Stat. 875, § 7407; renumbered § 7408, Pub. L. 94–455, title XII, § 1203(g), Oct. 4, 1976, 90 Stat. 1693; renumbered § 7409, Pub. L. 97–248, title III, § 321(a), Sept. 3, 1982, 96 Stat. 612; renumbered § 7410, Pub. L. 100–203, title X, § 10713(a)(1), Dec. 22, 1987, 101 Stat. 1330–468.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 26—","heading":"INTERNAL REVENUE CODE","identifier":"/us/usc/t26"},{"type":"subtitle","num":"Subtitle F—","heading":"Procedure and Administration","identifier":"/us/usc/t26/stF"},{"type":"chapter","num":"CHAPTER 76—","heading":"JUDICIAL PROCEEDINGS","identifier":"/us/usc/t26/stF/ch76"},{"type":"subchapter","num":"Subchapter A—","heading":"Civil Actions by the United States","identifier":"/us/usc/t26/stF/ch76/schA"}]}