{"title":"44","section":"3314","heading":"Procedures for disposal of records exclusive","lead":"The procedures prescribed by this chapter are exclusive, and records of the United States Government may not be alienated or destroyed except under this chapter.","tree":[],"notes":[{"topic":"historicalAndRevision","heading":"Historical and Revision Notes","text":"Based on 44 U.S. Code, 1964 ed., § 380 (July 7, 1943, ch. 192, § 15, 57 Stat. 383)."}],"sourceCredit":"(Pub. L. 90–620, Oct. 22, 1968, 82 Stat. 1302.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 44—","heading":"PUBLIC PRINTING AND DOCUMENTS","identifier":"/us/usc/t44"},{"type":"chapter","num":"CHAPTER 33—","heading":"DISPOSAL OF RECORDS","identifier":"/us/usc/t44/ch33"}]}