{"title":"44","section":"4104","heading":"Definition","lead":"As used in this chapter, the term “Federal electronic information” means Federal public information stored electronically.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 103–40, § 2(a), June 8, 1993, 107 Stat. 113.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 44—","heading":"PUBLIC PRINTING AND DOCUMENTS","identifier":"/us/usc/t44"},{"type":"chapter","num":"CHAPTER 41—","heading":"ACCESS TO FEDERAL ELECTRONIC INFORMATION","identifier":"/us/usc/t44/ch41"}]}