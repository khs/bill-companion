{"title":"27","section":"218","heading":"Civil penalties","lead":"Any person who violates the provisions of this subchapter shall be subject to a civil penalty of not more than $10,000, and each day shall constitute a separate offense.","tree":[],"notes":[],"sourceCredit":"(Aug. 29, 1935, ch. 814, title II, § 207, as added Pub. L. 100–690, title VIII, § 8001(a)(3), Nov. 18, 1988, 102 Stat. 4520.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 27—","heading":"INTOXICATING LIQUORS","identifier":"/us/usc/t27"},{"type":"chapter","num":"CHAPTER 8—","heading":"FEDERAL ALCOHOL ADMINISTRATION ACT","identifier":"/us/usc/t27/ch8"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"ALCOHOLIC BEVERAGE LABELING","identifier":"/us/usc/t27/ch8/schII"}]}