{"title":"5","section":"6363","heading":"Establishment of leave banks","lead":"Each agency that establishes a leave bank program under section 6362 shall establish 1 or more leave banks in accordance with regulations prescribed by the Office of Personnel Management.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 100–566, § 2(a), Oct. 31, 1988, 102 Stat. 2839.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 5—","heading":"GOVERNMENT ORGANIZATION AND EMPLOYEES","identifier":"/us/usc/t5"},{"type":"part","num":"PART III—","heading":"EMPLOYEES","identifier":"/us/usc/t5/ptIII"},{"type":"subpart","num":"Subpart E—","heading":"Attendance and Leave","identifier":"/us/usc/t5/ptIII/sptE"},{"type":"chapter","num":"CHAPTER 63—","heading":"LEAVE","identifier":"/us/usc/t5/ptIII/sptE/ch63"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"VOLUNTARY LEAVE BANK PROGRAM","identifier":"/us/usc/t5/ptIII/sptE/ch63/schIV"}]}