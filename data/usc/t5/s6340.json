{"title":"5","section":"6340","heading":"Inapplicability of certain provisions","lead":"Except to the extent that the Office of Personnel Management may prescribe regulations, nothing in section 7351 shall apply with respect to a solicitation, donation, or acceptance of leave under this subchapter.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 100–566, § 2(a), Oct. 31, 1988, 102 Stat. 2838.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 5—","heading":"GOVERNMENT ORGANIZATION AND EMPLOYEES","identifier":"/us/usc/t5"},{"type":"part","num":"PART III—","heading":"EMPLOYEES","identifier":"/us/usc/t5/ptIII"},{"type":"subpart","num":"Subpart E—","heading":"Attendance and Leave","identifier":"/us/usc/t5/ptIII/sptE"},{"type":"chapter","num":"CHAPTER 63—","heading":"LEAVE","identifier":"/us/usc/t5/ptIII/sptE/ch63"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"VOLUNTARY TRANSFERS OF LEAVE","identifier":"/us/usc/t5/ptIII/sptE/ch63/schIII"}]}