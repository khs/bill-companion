{"title":"5","section":"6371","heading":"Accrual of leave","lead":"While using leave made available to an employee from a leave bank, annual and sick leave shall accrue to the credit of such employee and shall become available for use by such employee in the same manner as provided for under section 6337.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 100–566, § 2(a), Oct. 31, 1988, 102 Stat. 2843.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 5—","heading":"GOVERNMENT ORGANIZATION AND EMPLOYEES","identifier":"/us/usc/t5"},{"type":"part","num":"PART III—","heading":"EMPLOYEES","identifier":"/us/usc/t5/ptIII"},{"type":"subpart","num":"Subpart E—","heading":"Attendance and Leave","identifier":"/us/usc/t5/ptIII/sptE"},{"type":"chapter","num":"CHAPTER 63—","heading":"LEAVE","identifier":"/us/usc/t5/ptIII/sptE/ch63"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"VOLUNTARY LEAVE BANK PROGRAM","identifier":"/us/usc/t5/ptIII/sptE/ch63/schIV"}]}