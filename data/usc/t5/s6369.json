{"title":"5","section":"6369","heading":"Restoration of transferred leave","lead":"The Office of Personnel Management shall establish procedures under which any transferred leave remaining to the credit of a leave recipient when the medical emergency affecting the leave recipient terminates, shall be restored to the leave bank.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 100–566, § 2(a), Oct. 31, 1988, 102 Stat. 2842.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 5—","heading":"GOVERNMENT ORGANIZATION AND EMPLOYEES","identifier":"/us/usc/t5"},{"type":"part","num":"PART III—","heading":"EMPLOYEES","identifier":"/us/usc/t5/ptIII"},{"type":"subpart","num":"Subpart E—","heading":"Attendance and Leave","identifier":"/us/usc/t5/ptIII/sptE"},{"type":"chapter","num":"CHAPTER 63—","heading":"LEAVE","identifier":"/us/usc/t5/ptIII/sptE/ch63"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"VOLUNTARY LEAVE BANK PROGRAM","identifier":"/us/usc/t5/ptIII/sptE/ch63/schIV"}]}