{"title":"34","section":"12212","heading":"Prohibition","lead":"None of the funds authorized under this part shall be used to finance the construction of housing.","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Section was formerly classified to section 13853 of Title 42, The Public Health and Welfare, prior to editorial reclassification and renumbering as this section."}],"sourceCredit":"(Pub. L. 103–322, title III, § 31133, Sept. 13, 1994, 108 Stat. 1888.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 34—","heading":"CRIME CONTROL AND LAW ENFORCEMENT","identifier":"/us/usc/t34"},{"type":"subtitle","num":"Subtitle I—","heading":"Comprehensive Acts","identifier":"/us/usc/t34/stI"},{"type":"chapter","num":"CHAPTER 121—","heading":"VIOLENT CRIME CONTROL AND LAW ENFORCEMENT","identifier":"/us/usc/t34/stI/ch121"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"CRIME PREVENTION","identifier":"/us/usc/t34/stI/ch121/schII"},{"type":"part","num":"Part E—","heading":"National Community Economic Partnership","identifier":"/us/usc/t34/stI/ch121/schII/ptE"},{"type":"subpart","num":"subpart 3—","heading":"miscellaneous provisions","identifier":"/us/usc/t34/stI/ch121/schII/ptE/spt3"}]}