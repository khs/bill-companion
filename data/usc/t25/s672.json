{"title":"25","section":"672","heading":"Omitted","lead":"","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Section, act Aug. 21, 1951, ch. 338, § 2, 65 Stat. 194, which related to division of trust funds, was omitted from the Code as being of special and not general application."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 25—","heading":"INDIANS","identifier":"/us/usc/t25"},{"type":"chapter","num":"CHAPTER 14—","heading":"MISCELLANEOUS","identifier":"/us/usc/t25/ch14"},{"type":"subchapter","num":"SUBCHAPTER XXVII—","heading":"UTE INDIANS OF UTAH","identifier":"/us/usc/t25/ch14/schXXVII"}]}