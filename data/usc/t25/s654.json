{"title":"25","section":"654","heading":"Omitted","lead":"","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Section, act May 18, 1928, ch. 624, § 4, 45 Stat. 602, which related to the filing and verification of claims, was omitted from the Code as being of special and not general application."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 25—","heading":"INDIANS","identifier":"/us/usc/t25"},{"type":"chapter","num":"CHAPTER 14—","heading":"MISCELLANEOUS","identifier":"/us/usc/t25/ch14"},{"type":"subchapter","num":"SUBCHAPTER XXV—","heading":"INDIANS OF CALIFORNIA","identifier":"/us/usc/t25/ch14/schXXV"}]}