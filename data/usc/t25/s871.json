{"title":"25","section":"871","heading":"Omitted","lead":"","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Section, Pub. L. 85–395, § 1, May 9, 1958, 72 Stat. 105, which related to membership roll, was omitted from the Code as being of special and not general application."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 25—","heading":"INDIANS","identifier":"/us/usc/t25"},{"type":"chapter","num":"CHAPTER 14—","heading":"MISCELLANEOUS","identifier":"/us/usc/t25/ch14"},{"type":"subchapter","num":"SUBCHAPTER XXXVIII—","heading":"OTOE AND MISSOURIA INDIANS","identifier":"/us/usc/t25/ch14/schXXXVIII"}]}