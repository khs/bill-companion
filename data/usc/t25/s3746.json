{"title":"25","section":"3746","heading":"Tribal immunity","lead":"Nothing in this chapter shall be construed to affect, modify, diminish, or otherwise impair the sovereign immunity from suit enjoyed by Indian tribes.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 103–177, title III, § 306, as added Pub. L. 103–435, § 12(b), Nov. 2, 1994, 108 Stat. 4572.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 25—","heading":"INDIANS","identifier":"/us/usc/t25"},{"type":"chapter","num":"CHAPTER 39—","heading":"AMERICAN INDIAN AGRICULTURAL RESOURCE MANAGEMENT","identifier":"/us/usc/t25/ch39"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"GENERAL PROVISIONS","identifier":"/us/usc/t25/ch39/schIII"}]}