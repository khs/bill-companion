{"title":"25","section":"610c","heading":"Omitted","lead":"","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Section, Pub. L. 90–534, § 4, Sept. 28, 1968, 82 Stat. 884, which related to mortgages and deeds of trust, was omitted from the Code as being of special and not general application."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 25—","heading":"INDIANS","identifier":"/us/usc/t25"},{"type":"chapter","num":"CHAPTER 14—","heading":"MISCELLANEOUS","identifier":"/us/usc/t25/ch14"},{"type":"subchapter","num":"SUBCHAPTER XVIII—","heading":"SWINOMISH TRIBE","identifier":"/us/usc/t25/ch14/schXVIII"}]}