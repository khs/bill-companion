{"title":"25","section":"1707","heading":"Omitted","lead":"","tree":[],"notes":[{"topic":"codification","heading":"Codification","text":"Section, Pub. L. 95–395, § 8, Sept. 30, 1978, 92 Stat. 816, which related to purchase and transfer of private settlement lands, was omitted from the Code as being of special and not general application."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 25—","heading":"INDIANS","identifier":"/us/usc/t25"},{"type":"chapter","num":"CHAPTER 19—","heading":"INDIAN LAND CLAIMS SETTLEMENTS","identifier":"/us/usc/t25/ch19"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"RHODE ISLAND INDIAN CLAIMS SETTLEMENT","identifier":"/us/usc/t25/ch19/schI"},{"type":"part","num":"Part A—","heading":"General Provisions","identifier":"/us/usc/t25/ch19/schI/ptA"}]}