{"title":"25","section":"1760","heading":"Omitted","lead":"","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Section, Pub. L. 98–134, § 11, Oct. 18, 1983, 97 Stat. 856, which provided for severability of provisions, was omitted from the Code as being of special and not general application."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 25—","heading":"INDIANS","identifier":"/us/usc/t25"},{"type":"chapter","num":"CHAPTER 19—","heading":"INDIAN LAND CLAIMS SETTLEMENTS","identifier":"/us/usc/t25/ch19"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"CONNECTICUT INDIAN LAND CLAIMS SETTLEMENT","identifier":"/us/usc/t25/ch19/schIV"}]}