{"title":"18","section":"1651","heading":"Piracy under law of nations","lead":"Whoever, on the high seas, commits the crime of piracy as defined by the law of nations, and is afterwards brought into or found in the United States, shall be imprisoned for life.","tree":[],"notes":[{"topic":"historicalAndRevision","heading":"Historical and Revision Notes","text":"Based on title 18, U.S.C., 1940 ed., § 481 (Mar. 4, 1909, ch. 321, § 290, 35 Stat. 1145)."}],"sourceCredit":"(June 25, 1948, ch. 645, 62 Stat. 774.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 18—","heading":"CRIMES AND CRIMINAL PROCEDURE","identifier":"/us/usc/t18"},{"type":"part","num":"PART I—","heading":"CRIMES","identifier":"/us/usc/t18/ptI"},{"type":"chapter","num":"CHAPTER 81—","heading":"PIRACY AND PRIVATEERING","identifier":"/us/usc/t18/ptI/ch81"}]}