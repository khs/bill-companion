{"title":"14","section":"1921","heading":"Corps of Cadets authorized strength","lead":"The number of cadets appointed annually to the Academy shall be as determined by the Secretary but the number appointed in any one year shall not exceed six hundred.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 115–282, title I, § 110(c)(1)(B), Dec. 4, 2018, 132 Stat. 4213.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 14—","heading":"COAST GUARD","identifier":"/us/usc/t14"},{"type":"subtitle","num":"SUBTITLE II—","heading":"PERSONNEL","identifier":"/us/usc/t14/stII"},{"type":"chapter","num":"CHAPTER 19—","heading":"COAST GUARD ACADEMY","identifier":"/us/usc/t14/stII/ch19"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"CADETS","identifier":"/us/usc/t14/stII/ch19/schII"}]}