{"title":"2","section":"2231","heading":"Establishment and accounts","lead":"There is established in the Treasury of the United States a revolving fund to be known as the Capitol Visitor Center Revolving Fund (in this section referred to as the “Fund”), consisting of the following individual accounts:","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"The Gift Shop Account.","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"The Miscellaneous Receipts Account.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 110–437, title III, § 301, Oct. 20, 2008, 122 Stat. 4989.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 2—","heading":"THE CONGRESS","identifier":"/us/usc/t2"},{"type":"chapter","num":"CHAPTER 31—","heading":"CAPITOL VISITOR CENTER","identifier":"/us/usc/t2/ch31"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"CAPITOL VISITOR CENTER REVOLVING FUND","identifier":"/us/usc/t2/ch31/schIII"}]}