{"title":"2","section":"282c","heading":"Expenditures","lead":"In accordance with policies and procedures approved by the Speaker, the Legislative Counsel may make such expenditures as may be necessary or appropriate for the functioning of the Office.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 91–510, title V, § 524, Oct. 26, 1970, 84 Stat. 1203.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 2—","heading":"THE CONGRESS","identifier":"/us/usc/t2"},{"type":"chapter","num":"CHAPTER 9—","heading":"OFFICE OF LEGISLATIVE COUNSEL","identifier":"/us/usc/t2/ch9"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"HOUSE OF REPRESENTATIVES","identifier":"/us/usc/t2/ch9/schII"},{"type":"part","num":"Part II—","heading":"Administration","identifier":"/us/usc/t2/ch9/schII/ptII"}]}