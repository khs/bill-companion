{"title":"2","section":"172","heading":"Definitions","lead":"As used in sections 171 to 175 of this title—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"the term Center means the Center for the Book;","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"the term Librarian means the Librarian of Congress.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 95–129, § 2, Oct. 13, 1977, 91 Stat. 1151.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 2—","heading":"THE CONGRESS","identifier":"/us/usc/t2"},{"type":"chapter","num":"CHAPTER 5—","heading":"LIBRARY OF CONGRESS","identifier":"/us/usc/t2/ch5"}]}