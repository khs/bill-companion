{"title":"22","section":"6592","heading":"Administrator of AID reporting to Secretary of State","lead":"The Administrator of the Agency for International Development, appointed pursuant to section 2384(a) of this title, shall report to and be under the direct authority and foreign policy guidance of the Secretary of State.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 105–277, div. G, subdiv. A, title XV, § 1522, Oct. 21, 1998, 112 Stat. 2681–794.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 22—","heading":"FOREIGN RELATIONS AND INTERCOURSE","identifier":"/us/usc/t22"},{"type":"chapter","num":"CHAPTER 74—","heading":"FOREIGN AFFAIRS AGENCIES CONSOLIDATION","identifier":"/us/usc/t22/ch74"},{"type":"subchapter","num":"SUBCHAPTER V—","heading":"AGENCY FOR INTERNATIONAL DEVELOPMENT","identifier":"/us/usc/t22/ch74/schV"},{"type":"part","num":"Part B—","heading":"Authorities of Secretary of State","identifier":"/us/usc/t22/ch74/schV/ptB"}]}