{"title":"22","section":"3783","heading":"Disposition of property of United States","lead":"No property of the United States located in the Republic of Panama may be disposed of except pursuant to law enacted by the Congress.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 96–70, title I, § 1503, Sept. 27, 1979, 93 Stat. 488.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 22—","heading":"FOREIGN RELATIONS AND INTERCOURSE","identifier":"/us/usc/t22"},{"type":"chapter","num":"CHAPTER 51—","heading":"PANAMA CANAL","identifier":"/us/usc/t22/ch51"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"ADMINISTRATION AND REGULATIONS","identifier":"/us/usc/t22/ch51/schI"},{"type":"part","num":"Part 5—","heading":"Public Property","identifier":"/us/usc/t22/ch51/schI/pt5"}]}