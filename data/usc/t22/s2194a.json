{"title":"22","section":"2194a","heading":"Omitted","lead":"","tree":[],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"codification","text":"Codification Section, Pub. L. 97–65, § 5(b)(2), Oct. 16, 1981, 95 Stat. 1023, which related to contract authority of the Overseas Private Investment Corporation, was omitted from the Code as obsolete pursuant to the termination of the Corporation by section 9684 of this title."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 22—","heading":"FOREIGN RELATIONS AND INTERCOURSE","identifier":"/us/usc/t22"},{"type":"chapter","num":"CHAPTER 32—","heading":"FOREIGN ASSISTANCE","identifier":"/us/usc/t22/ch32"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"INTERNATIONAL DEVELOPMENT","identifier":"/us/usc/t22/ch32/schI"},{"type":"part","num":"Part II—","heading":"Other Programs","identifier":"/us/usc/t22/ch32/schI/ptII"},{"type":"subpart","num":"subpart iv—","heading":"overseas private investment corporation","identifier":"/us/usc/t22/ch32/schI/ptII/sptiv"}]}