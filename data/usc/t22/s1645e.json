{"title":"22","section":"1645e","heading":"Offsets","lead":"In determining the amount of any claim under this subchapter, the Commission shall deduct all amounts the claimant has received from any source on account of the same loss or losses for which the claim is filed.","tree":[],"notes":[],"sourceCredit":"(Mar. 10, 1950, ch. 54, title VII, § 706, as added Pub. L. 96–606, Dec. 28, 1980, 94 Stat. 3536.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 22—","heading":"FOREIGN RELATIONS AND INTERCOURSE","identifier":"/us/usc/t22"},{"type":"chapter","num":"CHAPTER 21—","heading":"SETTLEMENT OF INTERNATIONAL CLAIMS","identifier":"/us/usc/t22/ch21"},{"type":"subchapter","num":"SUBCHAPTER VII—","heading":"CLAIMS AGAINST VIETNAM","identifier":"/us/usc/t22/ch21/schVII"}]}