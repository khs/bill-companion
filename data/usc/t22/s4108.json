{"title":"22","section":"4108","heading":"Functions of General Counsel","lead":"The General Counsel may—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"investigate alleged unfair labor practices under this subchapter,","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"file and prosecute complaints under this subchapter, and","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"exercise such other powers of the Board as the Board may prescribe.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 96–465, title I, § 1008, Oct. 17, 1980, 94 Stat. 2133.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 22—","heading":"FOREIGN RELATIONS AND INTERCOURSE","identifier":"/us/usc/t22"},{"type":"chapter","num":"CHAPTER 52—","heading":"FOREIGN SERVICE","identifier":"/us/usc/t22/ch52"},{"type":"subchapter","num":"SUBCHAPTER X—","heading":"LABOR-MANAGEMENT RELATIONS","identifier":"/us/usc/t22/ch52/schX"}]}