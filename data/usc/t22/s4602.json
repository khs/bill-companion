{"title":"22","section":"4602","heading":"Definitions","lead":"As used in this chapter, the term—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"“Institute” means the United States Institute of Peace established by this chapter; and","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"“Board” means the Board of Directors of the Institute.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 98–525, title XVII, § 1703, Oct. 19, 1984, 98 Stat. 2651.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 22—","heading":"FOREIGN RELATIONS AND INTERCOURSE","identifier":"/us/usc/t22"},{"type":"chapter","num":"CHAPTER 56—","heading":"UNITED STATES INSTITUTE OF PEACE","identifier":"/us/usc/t22/ch56"}]}