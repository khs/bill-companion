{"title":"45","section":"1213","heading":"Conflict with other laws","lead":"The provisions of this chapter shall govern if there is any conflict between this chapter and any other law.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 97–468, title VI, § 614, Jan. 14, 1983, 96 Stat. 2577.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 45—","heading":"RAILROADS","identifier":"/us/usc/t45"},{"type":"chapter","num":"CHAPTER 21—","heading":"ALASKA RAILROAD TRANSFER","identifier":"/us/usc/t45/ch21"}]}