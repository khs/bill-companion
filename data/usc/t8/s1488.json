{"title":"8","section":"1488","heading":"Nationality lost solely from performance of acts or fulfillment of conditions","lead":"The loss of nationality under this part shall result solely from the performance by a national of the acts or fulfillment of the conditions specified in this part.","tree":[],"notes":[],"sourceCredit":"(June 27, 1952, ch. 477, title III, ch. 3, § 356, 66 Stat. 272.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 8—","heading":"ALIENS AND NATIONALITY","identifier":"/us/usc/t8"},{"type":"chapter","num":"CHAPTER 12—","heading":"IMMIGRATION AND NATIONALITY","identifier":"/us/usc/t8/ch12"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"NATIONALITY AND NATURALIZATION","identifier":"/us/usc/t8/ch12/schIII"},{"type":"part","num":"Part III—","heading":"Loss of Nationality","identifier":"/us/usc/t8/ch12/schIII/ptIII"}]}