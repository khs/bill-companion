{"title":"49","section":"22906","heading":"Authorization of appropriations","lead":"There are authorized to be appropriated to the Secretary of Transportation for capital grants under this chapter the following amounts:","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"For fiscal year 2009, $100,000,000.","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"For fiscal year 2010, $300,000,000.","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"For fiscal year 2011, $400,000,000.","children":[]},{"marker":"(4)","path":"(4)","heading":"","text":"For fiscal year 2012, $500,000,000.","children":[]},{"marker":"(5)","path":"(5)","heading":"","text":"For fiscal year 2013, $600,000,000.","children":[]}],"notes":[{"topic":"editorialNotes","text":"Editorial Notes"},{"topic":"amendments","text":"Amendments2019—Pub. L. 115–420 renumbered section 24406 of this title as this section."}],"sourceCredit":"(Added Pub. L. 110–432, div. B, title III, § 301(a), Oct. 16, 2008, 122 Stat. 4946, § 24406; renumbered § 22906, Pub. L. 115–420, § 7(a)(1), Jan. 3, 2019, 132 Stat. 5445.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 49—","heading":"TRANSPORTATION","identifier":"/us/usc/t49"},{"type":"subtitle","num":"SUBTITLE V—","heading":"RAIL PROGRAMS","identifier":"/us/usc/t49/stV"},{"type":"part","num":"PART B—","heading":"ASSISTANCE","identifier":"/us/usc/t49/stV/ptB"},{"type":"chapter","num":"CHAPTER 229—","heading":"RAIL IMPROVEMENT GRANTS","identifier":"/us/usc/t49/stV/ptB/ch229"}]}