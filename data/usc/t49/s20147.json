{"title":"49","section":"20147","heading":"Warning of civil liability","lead":"The Secretary of Transportation shall encourage railroad carriers to warn the public about potential liability for violation of regulations related to vandalism of railroad signs, devices, and equipment and to trespassing on railroad property.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 103–440, title II, § 211(a), Nov. 2, 1994, 108 Stat. 4622.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 49—","heading":"TRANSPORTATION","identifier":"/us/usc/t49"},{"type":"subtitle","num":"SUBTITLE V—","heading":"RAIL PROGRAMS","identifier":"/us/usc/t49/stV"},{"type":"part","num":"PART A—","heading":"SAFETY","identifier":"/us/usc/t49/stV/ptA"},{"type":"chapter","num":"CHAPTER 201—","heading":"GENERAL","identifier":"/us/usc/t49/stV/ptA/ch201"},{"type":"subchapter","num":"SUBCHAPTER II—","heading":"PARTICULAR ASPECTS OF SAFETY","identifier":"/us/usc/t49/stV/ptA/ch201/schII"}]}