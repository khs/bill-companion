{"title":"49","section":"5908","heading":"Relationship to other laws","lead":"Nothing in this chapter affects—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"chapter 51 (relating to transportation of hazardous material) or the regulations promulgated under that chapter; or","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"any State highway weight or size law or regulation applicable to tractor-trailer combinations.","children":[]}],"notes":[],"sourceCredit":"(Added Pub. L. 104–291, title II, § 209(a), Oct. 11, 1996, 110 Stat. 3458.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 49—","heading":"TRANSPORTATION","identifier":"/us/usc/t49"},{"type":"subtitle","num":"SUBTITLE III—","heading":"GENERAL AND INTERMODAL PROGRAMS","identifier":"/us/usc/t49/stIII"},{"type":"chapter","num":"CHAPTER 59—","heading":"INTERMODAL SAFE CONTAINER TRANSPORTATION","identifier":"/us/usc/t49/stIII/ch59"}]}