{"title":"16","section":"667e","heading":"Repealed. Pub. L. 97–79, § 9(b)(2), Nov. 16, 1981, 95 Stat. 1079","lead":"","tree":[],"notes":[{"topic":"removalDescription","text":"Section, act May 25, 1900, ch. 553, § 5, 31 Stat. 188, provided that the dead bodies of game animals or game or song birds be subject to the laws of the State into which they are transported. See section 3378(a) of this title."}],"sourceCredit":"","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 16—","heading":"CONSERVATION","identifier":"/us/usc/t16"},{"type":"chapter","num":"CHAPTER 5A—","heading":"PROTECTION AND CONSERVATION OF WILDLIFE","identifier":"/us/usc/t16/ch5A"},{"type":"subchapter","num":"SUBCHAPTER I—","heading":"GAME, FUR-BEARING ANIMALS, AND FISH","identifier":"/us/usc/t16/ch5A/schI"}]}