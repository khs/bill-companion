{"title":"16","section":"6555","heading":"Relation to other laws","lead":"The authority provided to each Secretary under this subchapter is supplemental to, and not in lieu of, any authority provided to the Secretaries under any other law.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 108–148, title IV, § 405, Dec. 3, 2003, 117 Stat. 1911.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 16—","heading":"CONSERVATION","identifier":"/us/usc/t16"},{"type":"chapter","num":"CHAPTER 84—","heading":"HEALTHY FOREST RESTORATION","identifier":"/us/usc/t16/ch84"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"INSECT INFESTATIONS AND RELATED DISEASES","identifier":"/us/usc/t16/ch84/schIV"}]}