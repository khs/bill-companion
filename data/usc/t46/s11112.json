{"title":"46","section":"11112","heading":"Master’s lien for wages","lead":"The master of a documented vessel has the same lien against the vessel for the master’s wages and the same priority as any other seaman serving on the vessel.","tree":[],"notes":[],"sourceCredit":"(Added Pub. L. 99–307, § 1(19)(B), May 19, 1986, 100 Stat. 446.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 46—","heading":"SHIPPING","identifier":"/us/usc/t46"},{"type":"subtitle","num":"Subtitle II—","heading":"Vessels and Seamen","identifier":"/us/usc/t46/stII"},{"type":"part","num":"Part G—","heading":"Merchant Seamen Protection and Relief","identifier":"/us/usc/t46/stII/ptG"},{"type":"chapter","num":"CHAPTER 111—","heading":"PROTECTION AND RELIEF","identifier":"/us/usc/t46/stII/ptG/ch111"}]}