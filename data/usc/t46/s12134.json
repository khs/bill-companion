{"title":"46","section":"12134","heading":"Evidentiary uses of documentation","lead":"A certificate of documentation is—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"conclusive evidence of nationality for international purposes, but not in a proceeding conducted under the laws of the United States;","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"conclusive evidence of qualification to engage in a specified trade; and","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"not conclusive evidence of ownership in a proceeding in which ownership is in issue.","children":[]}],"notes":[{"topic":"historicalAndRevision","text":"Historical and Revision Notes RevisedSectionSource (U.S. Code)Source (Statutes at Large) 1213446:12104."}],"sourceCredit":"(Pub. L. 109–304, § 5, Oct. 6, 2006, 120 Stat. 1506.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 46—","heading":"SHIPPING","identifier":"/us/usc/t46"},{"type":"subtitle","num":"Subtitle II—","heading":"Vessels and Seamen","identifier":"/us/usc/t46/stII"},{"type":"part","num":"Part H—","heading":"Identification of Vessels","identifier":"/us/usc/t46/stII/ptH"},{"type":"chapter","num":"CHAPTER 121—","heading":"DOCUMENTATION OF VESSELS","identifier":"/us/usc/t46/stII/ptH/ch121"},{"type":"subchapter","num":"SUBCHAPTER III—","heading":"MISCELLANEOUS","identifier":"/us/usc/t46/stII/ptH/ch121/schIII"}]}