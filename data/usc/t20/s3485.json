{"title":"20","section":"3485","heading":"Seal of Department","lead":"The Secretary shall cause a seal of office to be made for the Department of such design as the Secretary shall approve. Judicial notice shall be taken of such seal.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 96–88, title IV, § 425, Oct. 17, 1979, 93 Stat. 688.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 20—","heading":"EDUCATION","identifier":"/us/usc/t20"},{"type":"chapter","num":"CHAPTER 48—","heading":"DEPARTMENT OF EDUCATION","identifier":"/us/usc/t20/ch48"},{"type":"subchapter","num":"SUBCHAPTER IV—","heading":"ADMINISTRATIVE PROVISIONS","identifier":"/us/usc/t20/ch48/schIV"},{"type":"part","num":"Part B—","heading":"General Administrative Provisions","identifier":"/us/usc/t20/ch48/schIV/ptB"}]}