{"title":"20","section":"9404","heading":"Authorization and appropriation of funds","lead":"There are authorized to be appropriated to the Department of Health and Human Services to carry out this chapter—","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"$750,000,000 for fiscal year 2001;","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"$1,000,000,000 for fiscal year 2002;","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"$1,500,000,000 for fiscal year 2003; and","children":[]},{"marker":"(4)","path":"(4)","heading":"","text":"such sums as may be necessary for each of the fiscal years 2004 and 2005.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 106–554, § 1(a)(1) [title VIII, § 805], Dec. 21, 2000, 114 Stat. 2763, 2763A–82.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 20—","heading":"EDUCATION","identifier":"/us/usc/t20"},{"type":"chapter","num":"CHAPTER 75—","heading":"EARLY LEARNING OPPORTUNITIES","identifier":"/us/usc/t20/ch75"}]}