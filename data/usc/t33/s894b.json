{"title":"33","section":"894b","heading":"Rights of the victim of a sexual assault","lead":"A victim of a sexual assault covered by the comprehensive policy developed under section 894a(a) of this title has the right to be reasonably protected from the accused.","tree":[],"notes":[],"sourceCredit":"(Pub. L. 114–328, div. C, title XXXV, § 3543, Dec. 23, 2016, 130 Stat. 2803.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 33—","heading":"NAVIGATION AND NAVIGABLE WATERS","identifier":"/us/usc/t33"},{"type":"chapter","num":"CHAPTER 17—","heading":"NATIONAL OCEANIC AND ATMOSPHERIC ADMINISTRATION","identifier":"/us/usc/t33/ch17"},{"type":"subchapter","num":"SUBCHAPTER VI—","heading":"SEXUAL HARASSMENT AND ASSAULT PREVENTION","identifier":"/us/usc/t33/ch17/schVI"}]}