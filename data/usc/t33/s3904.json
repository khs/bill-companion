{"title":"33","section":"3904","heading":"Eligible entities","lead":"The following entities are eligible to receive assistance under this chapter:","tree":[{"marker":"(1)","path":"(1)","heading":"","text":"A corporation.","children":[]},{"marker":"(2)","path":"(2)","heading":"","text":"A partnership.","children":[]},{"marker":"(3)","path":"(3)","heading":"","text":"A joint venture.","children":[]},{"marker":"(4)","path":"(4)","heading":"","text":"A trust.","children":[]},{"marker":"(5)","path":"(5)","heading":"","text":"A Federal, State, or local governmental entity, agency, or instrumentality.","children":[]},{"marker":"(6)","path":"(6)","heading":"","text":"A tribal government or consortium of tribal governments.","children":[]},{"marker":"(7)","path":"(7)","heading":"","text":"A State infrastructure financing authority.","children":[]}],"notes":[],"sourceCredit":"(Pub. L. 113–121, title V, § 5025, June 10, 2014, 128 Stat. 1334.)","releasePoint":"119-102","ancestors":[{"type":"title","num":"Title 33—","heading":"NAVIGATION AND NAVIGABLE WATERS","identifier":"/us/usc/t33"},{"type":"chapter","num":"CHAPTER 52—","heading":"WATER INFRASTRUCTURE FINANCE AND INNOVATION","identifier":"/us/usc/t33/ch52"}]}